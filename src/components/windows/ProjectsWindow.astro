---
// Showcase of the projects pitched at shtX (like SHT9's "ผลงานแห่งความเพี้ยน"). Data in src/data/projects.ts.
// Each card has an id (#<slug>) so a project can be linked: /x/?open=projects#cok-fight
import Window from '../Window.astro';
import Icon from '../Icon.astro';
import { projects } from '../../data/projects';
const people = new Set(projects.flatMap((p) => p.members)).size;
const tints = ['#245edb', '#3a9a2a', '#c7432b', '#7a4bd1', '#d68a00', '#0f8ea8'];
---

<Window id="projects" menu={['File', 'Edit', 'View', 'Favorites', 'Help']} status={`${projects.length} objects · ${people} คนโง่ · 11 ต.ค. 2026`}>
  <div class="pj">
    <header class="pj-head">
      <h2>ผลงานแห่งความเพี้ยน 🎨</h2>
      <p>{projects.length} โปรเจคที่ pitch ใน Stupid Hackathon X เรียงตามลำดับที่สุ่มขึ้นเวที</p>
    </header>
    <div class="pj-grid">
      {projects.map((p, i) => (
        <article class="pj-card" id={p.slug}>
          <div class="pj-band" style={`--t:${tints[i % tints.length]}`}>
            <span class="pj-emoji" aria-hidden="true">{p.emoji}</span>
            <span class="pj-no">#{p.no}</span>
          </div>
          <div class="pj-body">
            <h3><a href={`#${p.slug}`} class="pj-perma" title="ลิงก์ไปโปรเจคนี้">{p.name}</a></h3>
            <p class="pj-team">by {p.team}</p>
            <ul class="pj-members">{p.members.map((m) => <li>{m}</li>)}</ul>
            <p class="pj-desc">{p.description}</p>
            {p.links.length > 0 && (
              <div class="pj-links">
                {p.links.map((l) => (
                  <a class="xp-btn pj-link" href={l.url} target="_blank" rel="noopener">{l.kind === 'GitHub' ? '🐙' : l.kind === 'Slides' ? '📊' : '🌐'} {l.kind}</a>
                ))}
              </div>
            )}
            <div class="pj-clippy">
              <Icon name="paperclip" class="pj-clip" />
              <p><b>Clippy ว่าไง</b>{p.clippy}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Window>

<style>
  .pj { padding: 10px; background: #fff; }
  .pj-head { text-align: center; margin-bottom: 12px; }
  .pj-head h2 { display: inline-block; margin: 0; padding: 6px 16px; font-size: 18px; color: #fff; background: #245edb; border-radius: 6px; transform: rotate(-2deg); box-shadow: 2px 2px 0 #0a246a; }
  .pj-head p { margin: 8px 0 0; font-size: 11px; color: #555; }
  .pj-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 10px; }
  .pj-card { display: flex; flex-direction: column; border: 1px solid #7f9db9; border-radius: 6px; overflow: hidden; background: #fdfdfb; scroll-margin-top: 8px; }
  .pj-card:target { outline: 3px solid #f8b636; }
  .pj-band { position: relative; height: 64px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--t), color-mix(in srgb, var(--t) 55%, #000)); }
  .pj-band::after { content: ''; position: absolute; inset: 0 0 50% 0; background: linear-gradient(180deg, rgba(255, 255, 255, 0.35), rgba(255, 255, 255, 0)); }
  .pj-emoji { font-size: 36px; filter: drop-shadow(1px 2px 0 rgba(0, 0, 0, 0.35)); }
  .pj-no { position: absolute; top: 6px; left: 8px; z-index: 1; padding: 1px 7px; border-radius: 9px; font: bold 11px Tahoma, sans-serif; color: #fff; background: rgba(0, 0, 0, 0.35); }
  .pj-body { display: flex; flex-direction: column; gap: 6px; padding: 9px 10px 10px; flex: 1; }
  .pj-body h3 { margin: 0; font-size: 14px; line-height: 1.3; }
  .pj-perma { color: #0b2a5b; text-decoration: none; }
  .pj-perma:hover { text-decoration: underline; }
  .pj-team { margin: 0; font-size: 11px; font-weight: bold; color: #245edb; }
  .pj-members { display: flex; flex-wrap: wrap; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .pj-members li { padding: 1px 7px; font-size: 11px; background: #eef2f8; border: 1px solid #d3dbe8; border-radius: 9px; }
  .pj-desc { margin: 0; font-size: 12px; line-height: 1.45; color: #222; }
  .pj-links { display: flex; flex-wrap: wrap; gap: 5px; }
  .pj-link { font-size: 11px; padding: 3px 9px; text-decoration: none; color: #000; }
  .pj-clippy { display: flex; gap: 6px; align-items: flex-start; margin-top: auto; padding: 7px 8px; border: 1px solid #e3d48a; border-radius: 8px; background: #ffffe1; }
  .pj-clip { flex: none; width: 22px; height: 22px; margin-top: 1px; }
  .pj-clippy p { margin: 0; font-size: 11px; line-height: 1.4; color: #333; }
  .pj-clippy b { display: block; font-size: 10px; letter-spacing: 1px; color: #8a6d00; }
</style>
