---
import Window from '../Window.astro';
import Icon from '../Icon.astro';
---

<Window id="error" dialog beige>
  <div class="p-4 flex flex-col gap-4 h-full">
    <div class="flex items-center gap-3">
      <Icon name="warning" class="text-3xl shrink-0" />
      <p class="text-[12px]" id="error-text">ยังไม่เปิดลงทะเบียน</p>
    </div>
    <div class="flex justify-center gap-2 mt-auto">
      <button type="button" class="xp-btn default" data-action="close">OK</button>
      <button type="button" class="xp-btn" data-action="close">Also OK</button>
    </div>
  </div>
</Window>
