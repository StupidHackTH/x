---
import Window from '../Window.astro';
import { pastEditions } from '../../data/event';
---

<Window id="recycle" menu={['File', 'Edit', 'View', 'Help']} status={`${pastEditions.length} objects · 9 years of nonsense`}>
  <div class="p-2">
    <p class="text-[11px] text-neutral-600 mb-2">งานที่ผ่านมา 2017–2025 · ผู้เข้าร่วม 84–174 คนต่อครั้ง · 6–33 ทีม</p>
    <ul class="grid grid-cols-3 sm:grid-cols-5 gap-2">
      {pastEditions.map((p) => (
        <li>
          <a
            class="flex flex-col items-center text-center gap-1 p-2 hover:bg-[#316ac5] hover:text-white rounded-sm text-[11px] no-underline text-inherit"
            href={p.url ?? 'https://stupid.hackathon.in.th'}
            target="_blank"
            rel="noopener"
            title={p.note}
          >
            <span class="text-3xl" aria-hidden="true">📁</span>
            <span>SHT{p.edition}<br /><span class="opacity-70">{p.year}</span></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="text-[11px] mt-3">⭐ SHT9 (2025) ได้ rating สูงสุด 9.4/10 — <a href="https://stupid.hackathon.in.th/9/" target="_blank" rel="noopener">ดูผลงาน</a></p>
    <div class="mt-3 flex justify-end">
      <button type="button" class="xp-btn" data-action="close">Empty Recycle Bin</button>
    </div>
  </div>
</Window>
