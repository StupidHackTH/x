  @keyframes net-dead-glitch { 0%, 96% { transform: none; filter: none; } 97% { transform: translateX(3px); filter: hue-rotate(90deg); } 98% { transform: translateX(-3px); } 99% { transform: none; filter: invert(0.05); } }
