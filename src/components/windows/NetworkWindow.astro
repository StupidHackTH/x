</style>

<script>
  import { AudioModem, encodePcm, buildFrame } from '../../scripts/fsk';
  import { NetNode, encodeFrame, decodeFrame, type Established, type PeerCard, type NodeState, type LogKind } from '../../scripts/netproto';
  import { questions, packMac, formatMac, parseMac, icqFor, hostnameFor, vendorFor, traitsFor, LIMITS, CERT_LINKS, clampBytes, type Card, type Link } from '../../data/network';
  import { api, hasApi } from '../../scripts/netapi';
  import QRCode from 'qrcode';

  interface Me extends Card {
    answers: number[];
    created: number;
  }
  interface Store {
    me: Me | null;
    links: Link[];
    ransom?: { at: number; airAtStart: number; qr: number } | null; // the QR-abuser penalty: 3 real air links to decrypt
    dp?: { round: number; at: number; deadline: number; airAtStart: number; status: 'dead' | 'revived' | 'demoted' | 'restored'; airAtDeadline?: number } | null; // Dead Pixel round
  }

  const KEY = 'shtx-net-v1';
  const GOLD_LINKS = 40; // contacts needed for the Gold Edition certificate
  const PENDING = 'shtx-net-pending';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  function setupNetwork() {
    const root = $('net');
    const win = root.closest('.xp-window') as HTMLElement;
    if (!root || !win) return;

    const store: Store = load();
    let step = 0;
    const totalSteps = questions.length + 2;
    let newMac: Uint8Array | null = null;

    /* ---------- storage ---------- */
    function load(): Store {
      try {
        const s = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (s && typeof s === 'object') return { me: s.me ?? null, links: Array.isArray(s.links) ? s.links : [], ransom: s.ransom ?? null, dp: s.dp ?? null };
      } catch {
        /* ignore */
      }
      return { me: null, links: [] };
    }
    function save() {
      try {
        localStorage.setItem(KEY, JSON.stringify(store));
      } catch {
        /* ignore */
      }
    }

    /* ---------- wizard ---------- */
    const form = $('net-form');
    const pages = Array.from(form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-step]'));
    const stepItems = Array.from(form.querySelectorAll<HTMLLIElement>('.net-steps li'));
    const back = $('net-back') as HTMLButtonElement;
    const next = $('net-next') as HTMLButtonElement;
    const finish = $('net-finish') as HTMLButtonElement;

    function showStep(n: number) {
      step = Math.max(0, Math.min(totalSteps - 1, n));
      for (const p of pages) p.hidden = Number(p.dataset.step) !== step;
      stepItems.forEach((li, i) => {
        li.classList.toggle('current', i === step);
        li.classList.toggle('done', i < step);
      });
      back.disabled = step === 0;
      next.hidden = step === totalSteps - 1;
      finish.hidden = step !== totalSteps - 1;
      if (step === totalSteps - 1) preview();
    }
    function answers(): number[] {
      return questions.map((_, i) => {
        const v = form.querySelector<HTMLInputElement>(`input[name="q${i}"]:checked`)?.value;
        return v === undefined ? -1 : Number(v);
      });
    }
    function identity() {
      return {
        nick: clampBytes($<HTMLInputElement>('net-nick').value.trim(), LIMITS.nickBytes),
        skill: clampBytes($<HTMLInputElement>('net-skill').value.trim(), LIMITS.skillBytes),
        idea: clampBytes($<HTMLInputElement>('net-idea').value.trim(), LIMITS.ideaBytes),
      };
    }
    function validate(): boolean {
      if (step === 0) {
        const id = identity();
        const missing = !id.nick ? 'net-nick' : !id.skill ? 'net-skill' : !id.idea ? 'net-idea' : '';
        if (missing) {
          $<HTMLInputElement>(missing).focus();
          return false;
        }
        return true;
      }
      if (step >= 1 && step <= questions.length) return answers()[step - 1] >= 0;
      return true;
    }
    function preview() {
      if (!newMac) newMac = store.me ? parseMac(store.me.mac) ?? packMac(answers()) : packMac(answers());
      const mac = formatMac(newMac);
      $('net-new-mac').textContent = mac;
      $('net-new-vendor').textContent = vendorFor(mac);
      $('net-new-host').textContent = hostnameFor(identity().nick);
      $('net-new-icq').textContent = icqFor(mac);
    }
    back.addEventListener('click', () => showStep(step - 1));
    next.addEventListener('click', () => {
      if (!validate()) return;
      if (step === questions.length) newMac = store.me && sameAnswers() ? parseMac(store.me.mac) : packMac(answers());
      showStep(step + 1);
    });
    function sameAnswers() {
      return !!store.me && store.me.answers.join() === answers().join();
    }
    finish.addEventListener('click', () => {
      if (!newMac) return;
      const id = identity();
      store.me = { mac: formatMac(newMac), ...id, answers: answers(), created: store.me?.created ?? Date.now() };
      save();
      void api.register(store.me);
      showMain();
      const pending = sessionStorage.getItem(PENDING);
      if (pending) {
        sessionStorage.removeItem(PENDING);
        try {
          addFromParams(new URLSearchParams(pending));
        } catch {
          /* ignore */
        }
      }
    });
    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && step < totalSteps - 1) {
        e.preventDefault();
        next.click();
      }
    });

    function openWizard() {
      root.dataset.view = 'setup';
      (root.querySelector('[data-pane="setup"]') as HTMLElement).hidden = false;
      (root.querySelector('[data-pane="main"]') as HTMLElement).hidden = true;
      if (store.me) {
        $<HTMLInputElement>('net-nick').value = store.me.nick;
        $<HTMLInputElement>('net-skill').value = store.me.skill;
        $<HTMLInputElement>('net-idea').value = store.me.idea;
        store.me.answers.forEach((a, i) => {
          const r = form.querySelector<HTMLInputElement>(`input[name="q${i}"][value="${a}"]`);
          if (r) r.checked = true;
        });
      }
      newMac = null;
      showStep(0);
    }

    /* ---------- main view ---------- */
    const term = $('net-term');
    const statusEl = $('net-status');
    const subEl = $('net-substatus');
    const levelEl = $('net-level');
    const meter = levelEl.parentElement as HTMLElement;
    const listenBtn = $('net-listen') as HTMLButtonElement;
    const connectBtn = $('net-connect') as HTMLButtonElement;
    const pingBtn = $('net-ping') as HTMLButtonElement;
    const stats = { crc: 0 };

    function log(line: string, kind: LogKind = 'info') {
      const d = new Date();
      const t = [d.getHours(), d.getMinutes(), d.getSeconds()].map((v) => String(v).padStart(2, '0')).join(':');
      const el = document.createElement('div');
      el.className = `l ${kind}`;
      el.textContent = `[${t}] ${line}`;
      term.appendChild(el);
      while (term.childElementCount > 200) term.firstElementChild?.remove();
      term.scrollTop = term.scrollHeight;
    }

    const modem = new AudioModem();
    let node: NetNode | null = null;
    let resetTimer: ReturnType<typeof setTimeout> | null = null;

    function online() {
      return hasApi() && navigator.onLine;
    }

    function makeNode() {
      const me = store.me!;
      node = new NetNode(
        { mac: parseMac(me.mac)!, nick: me.nick, skill: me.skill, idea: me.idea },
        modem,
        {
          log,
          onState: (s) => setLinkState(s),
          onEstablished: onEstablished,
          onCard: onCard,
          online,
        },
      );
      node.minSynLevel = Number($<HTMLSelectElement>('net-range').value);
      modem.onFrame = (p, level) => node?.receive(p, level);
    }

    function setLinkState(s: NodeState) {
      root.dataset.link = s;
      const texts: Record<NodeState, [string, string]> = {
        idle: [modem.listening ? 'Listening' : 'Not connected', modem.listening ? 'ไมค์เปิดอยู่ รอฟัง SYN จากคนข้าง ๆ' : 'กด Start เพื่อเปิดไมค์และฟังสัญญาณ'],
        syn_sent: ['Dialing…', 'ส่ง SYN แล้ว รอ SYN-ACK (ถือมือถือให้ใกล้กัน)'],
        ack_sent: ['Acknowledging…', 'เลือกเครื่องที่ใกล้สุดแล้ว กำลังส่ง ACK'],
        synack_sent: ['Incoming connection…', 'ได้ยิน SYN แล้ว ตอบ SYN-ACK กลับไป รอ ACK'],
        established: ['Connected', 'จับมือสำเร็จ กำลังแลกนามบัตร'],
      };
      const [a, b] = texts[s];
      statusEl.textContent = a;
      subEl.textContent = b;
      connectBtn.textContent = s === 'syn_sent' || s === 'ack_sent' || s === 'synack_sent' ? 'Cancel' : 'Connect (SYN)';
      connectBtn.disabled = !modem.listening && s === 'idle' && false;
    }

    const inAppBrowser = /FBAN|FBAV|FB_IAB|Messenger|Line\/|Instagram|Twitter|TikTok/i.test(navigator.userAgent);
    async function startListening(): Promise<boolean> {
      if (modem.listening) return true;
      if (!navigator.mediaDevices?.getUserMedia) {
        const why = inAppBrowser ? 'เบราว์เซอร์ในแอป (LINE/Facebook/Messenger) ไม่ให้ใช้ไมค์' : !window.isSecureContext ? 'ต้องเปิดผ่าน https' : 'เบราว์เซอร์นี้ไม่รองรับไมค์';
        log(`Microphone unavailable: ${why}`, 'err');
        statusEl.textContent = 'ใช้ไมค์ไม่ได้';
        subEl.textContent = `${why} กดเมนู ⋯ แล้วเลือก "เปิดใน Safari/Chrome" หรือใช้ QR fallback`;
        return false;
      }
      try {
        await modem.listen();
      } catch (e) {
        const err = e as Error;
        const why = err.name === 'NotAllowedError' ? 'ไม่ได้รับอนุญาตให้ใช้ไมค์ (กด Allow หรือเปิดสิทธิ์ในตั้งค่าเบราว์เซอร์)' : err.name === 'NotFoundError' ? 'ไม่พบไมโครโฟน' : err.message;
        log(`Microphone unavailable: ${err.name} ${err.message}`, 'err');
        statusEl.textContent = 'เปิดไมค์ไม่ได้';
        subEl.textContent = `${why} หรือใช้ QR fallback`;
        return false;
      }
      if (modem.ctx && modem.ctx.state !== 'running') log(`AudioContext is ${modem.ctx.state}; tap Start again if nothing moves`, 'err');
      root.dataset.listen = 'on';
      listenBtn.textContent = 'Stop listening';
      pingBtn.disabled = false;
      connectBtn.disabled = false;
      log(`Listening on microphone (${modem.ctx?.sampleRate} Hz, ${modem.o.baud} baud, ${modem.o.f0}/${modem.o.f1} Hz)`, 'info');
      if (!node) makeNode();
      setLinkState(node!.state);
      return true;
    }

    function stopListening() {
      modem.stop();
      node?.cancel();
      root.dataset.listen = 'off';
      listenBtn.textContent = 'Start listening';
      pingBtn.disabled = true;
      levelEl.style.width = '0';
      $('net-levelnum').textContent = '—';
      meter.removeAttribute('data-busy');
      if (node) setLinkState(node.state);
      log('Microphone released', 'info');
    }

    let levelTick = 0;
    modem.onLevel = (level, busy) => {
      levelEl.style.width = `${Math.round(Math.min(1, level * 1.5) * 100)}%`;
      if (++levelTick % 5 === 0) $('net-levelnum').textContent = (level / 4).toFixed(3);
      if (busy) meter.setAttribute('data-busy', '');
      else meter.removeAttribute('data-busy');
      const errs = modem.decoder?.errors ?? 0;
      if (errs !== stats.crc) {
        stats.crc = errs;
        renderStats();
        reportCrc();
      }
    };

    /* NOC telemetry: CRC errors, batched every 30 s so 60 phones do not hammer the server */
    let crcReported = 0;
    let crcTimer: ReturnType<typeof setTimeout> | null = null;
    function reportCrc() {
      if (!online() || crcTimer || !store.me) return;
      crcTimer = setTimeout(() => {
        crcTimer = null;
        const delta = stats.crc - crcReported;
        if (delta > 0 && store.me) {
          crcReported = stats.crc;
          void api.event('crc', store.me.mac, String(delta));
        }
      }, 30_000);
    }

    let netPaused = false;
    async function refreshPause() {
      if (!online()) return;
      const p = await api.pause();
      if (!p) return;
      netPaused = p.net;
      root.dataset.paused = netPaused ? '1' : '';
      handleDeadPixel(p.dp ?? null);
      if (netPaused) {
        statusEl.textContent = 'Paused by staff';
        subEl.textContent = 'ทีมงานหยุดเกมชั่วคราว รอประกาศ';
      } else if (node) setLinkState(node.state);
    }
    void refreshPause();
    setInterval(() => void refreshPause(), 20_000);

    listenBtn.addEventListener('click', () => (modem.listening ? stopListening() : void startListening()));
    connectBtn.addEventListener('click', async () => {
      if (netPaused) {
        log('Game paused by staff. Connect is disabled until they resume.', 'err');
        return;
      }
      if (!(await startListening())) return;
      if (!node) return;
      if (node.state === 'idle' || node.state === 'established') {
        if (resetTimer) clearTimeout(resetTimer);
        node.reset();
        node.connect();
      } else node.cancel();
    });
    pingBtn.addEventListener('click', () => void node?.ping());
    $<HTMLSelectElement>('net-range').addEventListener('change', (e) => {
      if (node) node.minSynLevel = Number((e.target as HTMLSelectElement).value);
    });

    function upsertLink(l: Link) {
      const i = store.links.findIndex((x) => x.mac === l.mac);
      if (i >= 0) store.links[i] = { ...store.links[i], ...l, skill: l.skill || store.links[i].skill, idea: l.idea || store.links[i].idea, at: store.links[i].at };
      else store.links.unshift(l);
      save();
      renderContacts();
    }

    function scheduleReset(ms: number) {
      if (resetTimer) clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        node?.reset();
        resetTimer = null;
      }, ms);
    }

    function onEstablished(link: Established) {
      const mac = formatMac(link.peer);
      upsertLink({ mac, nick: link.nick, via: 'air', at: Date.now() });
      checkRansomProgress();
      showPeer(mac, link.needCards ? 'กำลังรับนามบัตรผ่านเสียง (ประมาณ 5 วินาที)…' : 'ดึงนามบัตรจาก NOC…');
      if (online()) {
        void api.register(store.me!).then(() => api.link(store.me!.mac, mac, 'air', { seq: link.seq, ack: link.ack }));
        void api.node(mac).then((c) => {
          if (c) {
            upsertLink({ mac, nick: c.nick || link.nick, skill: c.skill, idea: c.idea, via: 'air', at: Date.now() });
            showPeer(mac, '');
          }
        });
      }
      scheduleReset(link.needCards ? 25_000 : 8_000);
      renderStats();
    }

    function onCard(card: PeerCard) {
      const mac = formatMac(card.peer);
      const existing = store.links.find((l) => l.mac === mac);
      upsertLink({ mac, nick: existing?.nick ?? '', skill: card.skill, idea: card.idea, via: 'air', at: Date.now() });
      showPeer(mac, '');
      scheduleReset(4_000);
    }

    /* ---------- render ---------- */
    function renderMe() {
      const me = store.me!;
      $('net-me-nick').textContent = me.nick;
      $('net-me-skill').textContent = me.skill;
      $('net-me-idea').textContent = `“${me.idea}”`;
      $('net-me-icq').textContent = icqFor(me.mac);
      $('net-me-mac').textContent = me.mac;
    }
    function renderContacts() {
      const ul = $('net-contacts');
      ul.innerHTML = '';
      for (const l of store.links) {
        const li = document.createElement('li');
        li.className = 'net-contact';
        const when = new Date(l.at);
        const hhmm = `${String(when.getHours()).padStart(2, '0')}:${String(when.getMinutes()).padStart(2, '0')}`;
        li.innerHTML = `<b></b><span class="via ${l.via}">${l.via}</span><span class="skill"></span><span class="t"></span><span class="idea"></span><span class="mac"></span>`;
        li.tabIndex = 0;
        li.setAttribute('role', 'button');
        li.title = 'ดูรายละเอียด';
        const open = () => showPeer(l.mac, `เชื่อมผ่าน ${l.via} · ${new Date(l.at).toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' })}`);
        li.addEventListener('click', open);
        li.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') open();
        });
        li.querySelector('b')!.textContent = l.nick || '(ไม่ทราบชื่อ)';
        li.querySelector('.skill')!.textContent = l.skill || '—';
        li.querySelector('.t')!.textContent = hhmm;
        li.querySelector('.idea')!.textContent = l.idea ? `“${l.idea}”` : '';
        li.querySelector('.mac')!.textContent = `${l.mac} · ICQ ${icqFor(l.mac)}`;
        ul.appendChild(li);
      }
      $('net-count').textContent = `(${store.links.length})${store.links.length >= GOLD_LINKS ? ' · GOLD' : ''}`;
      $('net-empty').hidden = store.links.length > 0;
      ($('net-cert-btn') as HTMLButtonElement).disabled = store.links.length < CERT_LINKS;
    }
    function renderStats() {
      const s = node?.stats ?? { tx: 0, rx: 0, ignoredFar: 0, timeouts: 0 };
      $('net-stats').textContent = `TX ${s.tx} · RX ${s.rx} · CRC errors ${stats.crc} · far hosts ignored ${s.ignoredFar} · timeouts ${s.timeouts} · NOC: ${online() ? 'online' : 'offline'}`;
    }

    function showMain() {
      root.dataset.view = 'main';
      (root.querySelector('[data-pane="setup"]') as HTMLElement).hidden = true;
      (root.querySelector('[data-pane="main"]') as HTMLElement).hidden = false;
      renderMe();
      renderContacts();
      renderStats();
      if (node) {
        const me = store.me!;
        node.me = { mac: parseMac(me.mac)!, nick: me.nick, skill: me.skill, idea: me.idea };
      }
      if (online()) void api.register(store.me!);
      void syncFromServer();
      renderRansom();
      checkRansomProgress();
      if (store.ransom) showRansom();
      else void pollRansom();
    }

    async function syncFromServer() {
      if (!store.me || !online()) return;
      const r = await api.linksOf(store.me.mac);
      if (!r) return;
      let changed = false;
      for (const l of r.links) {
        if (store.links.some((x) => x.mac === l.mac)) continue;
        store.links.push({ mac: l.mac, nick: l.nick, skill: l.skill, idea: l.idea, via: (l.via as Link['via']) || 'qr', at: l.at || Date.now() });
        changed = true;
      }
      if (changed) {
        store.links.sort((a, b) => b.at - a.at);
        save();
        renderContacts();
        log(`Synced ${r.links.length} link(s) from NOC`, 'info');
      }
    }

    /* ---------- ransomware (the QR abuser) ---------- */
    const RANSOM_AIR = 3;
    const RANSOM_TTL = 4 * 3600 * 1000; // the penalty expires by itself after 4 hours
    const airLinks = () => store.links.filter((l) => l.via === 'air').length;
    // Emergency Alert System audio: the two-tone attention signal (853 Hz + 960 Hz, like the real EAS) for 8 s, then a siren.
    let alarm: { nodes: AudioScheduledSourceNode[]; timer: number } | null = null;
    async function alarmOn() {
      if (alarm) return;
      try {
        const ctx = modem.ctx ?? (modem.ctx = new (window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext)());
        if (ctx.state !== 'running') await ctx.resume();
        const t0 = ctx.currentTime;
        const attention = 8;
        const nodes: AudioScheduledSourceNode[] = [];
        const master = ctx.createGain();
        master.gain.value = 0.4;
        master.connect(ctx.destination);
        for (const f of [853, 960]) {
          const o = ctx.createOscillator();
          const g = ctx.createGain();
          o.type = 'sine';
          o.frequency.value = f;
          g.gain.setValueAtTime(0.5, t0);
          g.gain.setValueAtTime(0, t0 + attention);
          o.connect(g).connect(master);
          o.start(t0);
          o.stop(t0 + attention + 0.05);
          nodes.push(o);
        }
        const osc = ctx.createOscillator();
        const lfo = ctx.createOscillator();
        const lfoGain = ctx.createGain();
        const sirenGain = ctx.createGain();
        osc.type = 'square';
        osc.frequency.value = 900;
        lfo.type = 'triangle';
        lfo.frequency.value = 2.5;
        lfoGain.gain.value = 350;
        lfo.connect(lfoGain).connect(osc.frequency);
        sirenGain.gain.setValueAtTime(0, t0);
        sirenGain.gain.setValueAtTime(0.8, t0 + attention);
        osc.connect(sirenGain).connect(master);
        osc.start(t0 + attention);
        lfo.start(t0);
        nodes.push(osc, lfo);
        const timer = window.setInterval(() => navigator.vibrate?.([600, 200, 600, 200, 600]), 2600);
        navigator.vibrate?.([600, 200, 600, 200, 600]);
        alarm = { nodes, timer };
      } catch {
        /* no audio */
      }
    }
    function alarmOff() {
      if (!alarm) return;
      clearInterval(alarm.timer);
      navigator.vibrate?.(0);
      for (const n of alarm.nodes) {
        try {
          n.stop();
        } catch {
          /* already stopped */
        }
      }
      alarm = null;
    }
    function renderRansom() {
      const r = store.ransom;
      root.dataset.ransom = r ? '1' : '';
      ($('net-qr') as HTMLButtonElement).textContent = r ? 'QR ENCRYPTED' : 'QR fallback';
      ($('net-manual-btn') as HTMLButtonElement).disabled = !!r;
      if (!r) return;
      $('net-ransom-count').textContent = String(r.qr);
      const left = String(Math.max(0, RANSOM_AIR - (airLinks() - r.airAtStart)));
      $('net-ransom-left').textContent = left;
      $('net-ransom-left-th').textContent = left;
    }
    function showRansom() {
      renderRansom();
      const el = $('net-ransom');
      if (el.parentElement !== document.body) document.body.appendChild(el); // escape the window so it covers the whole screen
      el.hidden = false;
      void alarmOn();
      log('!!! RANSOMWARE DETECTED: QR fallback encrypted. Connect via AIR to decrypt. !!!', 'err');
    }
    function startRansom(qr: number) {
      store.ransom = { at: Date.now(), airAtStart: airLinks(), qr };
      save();
      showRansom();
    }
    function checkRansomProgress() {
      const r = store.ransom;
      if (!r) return;
      if (Date.now() - r.at >= RANSOM_TTL) {
        store.ransom = null;
        save();
        alarmOff();
        $('net-ransom').hidden = true;
        renderRansom();
        log('Ransomware expired (4 h). QR fallback restored. Try talking to people next time.', 'ok');
        return;
      }
      if (airLinks() - r.airAtStart >= RANSOM_AIR) {
        store.ransom = null;
        save();
        alarmOff();
        $('net-ransom').hidden = true;
        renderRansom();
        log('DECRYPTED. Your QR fallback is back. Welcome to the real world.', 'ok');
      } else renderRansom();
    }
    async function pollRansom() {
      if (!store.me || !online() || store.ransom) return;
      const r = await api.ransom();
      if (r && r.macs.includes(store.me.mac)) startRansom(r.top?.qr ?? store.links.filter((l) => l.via === 'qr').length);
    }
    $('net-ransom-ok').addEventListener('click', () => {
      alarmOff();
      $('net-ransom').hidden = true;
    });
    document.addEventListener('pointerdown', () => {
      if (!$('net-ransom').hidden && !alarm) void alarmOn();
    });
    setInterval(() => {
      if (store.ransom && Date.now() - store.ransom.at >= RANSOM_TTL) checkRansomProgress();
      if ($('net-ransom').hidden) return;
      const left = Math.max(0, RANSOM_TTL - (Date.now() - (store.ransom?.at ?? Date.now())));
      const h = Math.floor(left / 3_600_000);
      const m = Math.floor((left % 3_600_000) / 60_000);
      const sec = Math.floor((left % 60_000) / 1000);
      $('net-ransom-timer').textContent = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
    }, 1000);
    setInterval(() => void pollRansom(), 60_000);

    /* ---------- Dead Pixel (staff kill random nodes; one new AIR link revives) ---------- */
    const DEAD_RESTORE = 2;
    function fmtLeft(ms: number) {
      const s = Math.max(0, Math.floor(ms / 1000));
      return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
    }
    function showDead(mode: 'dead' | 'revived' | 'demoted') {
      const el = $('net-dead');
      if (el.parentElement !== document.body) document.body.appendChild(el);
      el.dataset.mode = mode;
      const d = store.dp!;
      $('net-dead-round').textContent = String(d.round);
      $('net-dead-mac').textContent = store.me?.mac ?? '—';
      $('net-dead-x').textContent = String(d.at % 1920);
      $('net-dead-y').textContent = String(d.deadline % 1080);
      if (mode === 'dead') {
        $('net-dead-title').textContent = 'DEAD PIXEL DETECTED';
        $('net-dead-text').innerHTML = 'Your node was randomly selected for termination. Make <b>1 new AIR connection</b> (a real acoustic handshake) before the countdown ends to stay routable. Otherwise your Proof of Friendship is <b>revoked</b> until you make 2 more.';
        $('net-dead-th').textContent = 'node ของคุณถูกสุ่มให้ตาย ไปจ่อมือถือกับคนใหม่ 1 คนแล้วกด Connect ทางเสียงก่อนหมดเวลา ไม่งั้นใบ cert ถูกถอน (คืนได้เมื่อ air link เพิ่มอีก 2)';
        $('net-dead-ok').textContent = 'OK · ไปหาคน';
        navigator.vibrate?.([200, 100, 200, 100, 800]);
      } else if (mode === 'revived') {
        $('net-dead-title').textContent = 'PIXEL REVIVED';
        $('net-dead-text').innerHTML = 'AIR link confirmed. Your node is routable again. Carry on being stupid.';
        $('net-dead-th').textContent = 'รอดแล้ว node กลับมาใช้งานได้ตามปกติ';
        $('net-dead-ok').textContent = 'Nice';
      } else {
        $('net-dead-title').textContent = 'CERTIFICATE REVOKED';
        $('net-dead-text').innerHTML = 'Deadline passed with no new AIR link. Your Proof of Friendship now reads <b>DEAD PIXEL</b> until you make <b>2 more AIR connections</b>.';
        $('net-dead-th').textContent = 'หมดเวลา ใบ cert ถูกถอน ต่อ air link อีก 2 คนเพื่อเอาคืน';
        $('net-dead-ok').textContent = 'ก็ได้';
      }
      el.hidden = false;
    }
    function handleDeadPixel(dp: { round: number; at: number; deadline: number; macs: string[] } | null) {
      if (!store.me) return;
      if (!dp) return; // rounds are never cancelled on the phone; an ended round just stops being delivered
      if (!dp.macs.includes(store.me.mac)) return;
      if (store.dp && store.dp.round >= dp.round) return;
      if (Date.now() > dp.deadline) return; // round already over when we first heard about it
      store.dp = { round: dp.round, at: dp.at, deadline: dp.deadline, airAtStart: airLinks(), status: 'dead' };
      save();
      log(`!!! DEAD PIXEL round ${dp.round}: this node was selected for termination. One new AIR link before ${new Date(dp.deadline).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' })} or the certificate is revoked. !!!`, 'err');
      showDead('dead');
    }
    function checkDeadPixel() {
      const d = store.dp;
      if (!d) return;
      const now = Date.now();
      if (d.status === 'dead') {
        if (airLinks() > d.airAtStart) {
          d.status = 'revived';
          save();
          log('DEAD PIXEL: AIR link confirmed — node revived.', 'ok');
          showDead('revived');
          return;
        }
        if (now > d.deadline) {
          d.status = 'demoted';
          d.airAtDeadline = airLinks();
          save();
          log('DEAD PIXEL: deadline passed — Proof of Friendship REVOKED until 2 more AIR links.', 'err');
          showDead('demoted');
          return;
        }
        if (!$('net-dead').hidden) $('net-dead-timer').textContent = fmtLeft(d.deadline - now);
      } else if (d.status === 'demoted' && airLinks() - (d.airAtDeadline ?? 0) >= DEAD_RESTORE) {
        d.status = 'restored';
        save();
        log('DEAD PIXEL: 2 new AIR links — certificate restored.', 'ok');
      }
    }
    $('net-dead-ok').addEventListener('click', () => {
      $('net-dead').hidden = true;
    });
    setInterval(checkDeadPixel, 1000);
    if (store.dp?.status === 'dead') showDead('dead');

    /* ---------- overlays ---------- */
    root.querySelectorAll<HTMLButtonElement>('[data-close-overlay]').forEach((b) =>
      b.addEventListener('click', () => {
        (b.closest('.net-overlay') as HTMLElement).hidden = true;
      }),
    );

    function showPeer(mac: string, note: string) {
      const l = store.links.find((x) => x.mac === mac);
      if (!l) return;
      $('net-peer-nick').textContent = l.nick || '(ไม่ทราบชื่อ)';
      $('net-peer-skill').textContent = l.skill || '…';
      $('net-peer-idea').textContent = l.idea ? `“${l.idea}”` : '…';
      $('net-peer-icq').textContent = icqFor(mac);
      $('net-peer-mac').textContent = `${mac} · ${vendorFor(mac)}`;
      const traits = $('net-peer-traits');
      traits.innerHTML = '';
      traitsFor(mac).forEach((t, i) => {
        const li = document.createElement('li');
        li.textContent = `${questions[i].q}: ${t}`;
        traits.appendChild(li);
      });
      $('net-peer-note').textContent = note;
      $('net-peer').hidden = false;
    }

    $('net-edit').addEventListener('click', openWizard);

    $('net-qr').addEventListener('click', async () => {
      if (store.ransom) {
        showRansom();
        return;
      }
      const me = store.me!;
      const u = new URL(location.href);
      u.search = '';
      u.hash = '';
      const p = new URLSearchParams({ skip: '', open: 'shtxnet', peer: me.mac.replace(/:/g, ''), n: me.nick, s: me.skill, i: me.idea });
      const link = `${u.toString()}?${p.toString().replace('skip=&', 'skip&')}`;
      $<HTMLInputElement>('net-qr-link').value = link;
      try {
        await QRCode.toCanvas($('net-qr-canvas') as HTMLCanvasElement, link, { width: 240, margin: 1, errorCorrectionLevel: 'M' });
      } catch (e) {
        log(`QR failed: ${(e as Error).message}`, 'err');
      }
      $('net-qr-overlay').hidden = false;
    });
    $('net-qr-copy').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText($<HTMLInputElement>('net-qr-link').value);
        $('net-qr-copy').textContent = 'Copied';
        setTimeout(() => ($('net-qr-copy').textContent = 'Copy link'), 1500);
      } catch {
        $<HTMLInputElement>('net-qr-link').select();
      }
    });

    $('net-manual-btn').addEventListener('click', () => {
      if (store.ransom) {
        showRansom();
        return;
      }
      $('net-manual-err').hidden = true;
      $('net-manual').hidden = false;
      $<HTMLInputElement>('net-manual-mac').focus();
    });
    $('net-manual-go').addEventListener('click', async () => {
      const err = $('net-manual-err');
      const mac = parseMac($<HTMLInputElement>('net-manual-mac').value);
      const fail = (m: string) => {
        err.textContent = m;
        err.hidden = false;
      };
      if (!mac) return fail('MAC ต้องเป็นเลขฐานสิบหก 12 หลัก เช่น 02:1A:2B:3C:4D:5E');
      const s = formatMac(mac);
      if (s === store.me!.mac) return fail('นั่นคุณเอง');
      if (!online()) return fail('ตอนนี้ offline จาก NOC ใช้เสียงหรือ QR แทน');
      const card = await api.node(s);
      if (!card) return fail('ไม่พบ host นี้ใน NOC (เขายังไม่ได้ลงทะเบียน หรือพิมพ์ผิด)');
      upsertLink({ mac: s, nick: card.nick, skill: card.skill, idea: card.idea, via: 'manual', at: Date.now() });
      void api.register(store.me!).then(() => api.link(store.me!.mac, s, 'manual'));
      $('net-manual').hidden = true;
      log(`Manual link to ${card.nick} [${s}] via NOC`, 'ok');
      showPeer(s, 'เชื่อมผ่าน NOC (ไม่มีเสียงโมเด็ม เสียดายนะ)');
    });

    $('net-cert-btn').addEventListener('click', () => {
      const me = store.me!;
      const gold = store.links.length >= GOLD_LINKS;
      const dead = store.dp?.status === 'demoted';
      $('net-certificate').classList.toggle('gold', gold && !dead);
      $('net-certificate').classList.toggle('dead', dead);
      $('net-cert-rank').textContent = dead ? 'Dead Pixel (certificate REVOKED — 2 more AIR links to restore)' : gold ? 'Gold Core Switch' : 'Fully Routable Host';
      $('net-cert-seal').innerHTML = dead ? 'DEAD<br />PIXEL' : gold ? 'GOLD<br />40+' : 'CSMA/CA<br />APPROVED';
      $('net-cert-name').textContent = me.nick;
      $('net-cert-mac').textContent = me.mac;
      $('net-cert-count').textContent = String(store.links.length);
      $('net-cert-peers').textContent = `Peers: ${store.links.map((l) => l.nick || l.mac).join(' · ')}`;
      $('net-cert-date').textContent = new Date().toLocaleDateString('th-TH', { day: 'numeric', month: 'long', year: 'numeric' });
      $('net-cert').hidden = false;
    });
    $('net-cert-print').addEventListener('click', () => {
      const w = window.open('', '_blank', 'width=820,height=620');
      if (!w) return;
      const css = Array.from(document.querySelectorAll('style')).map((s) => s.textContent).join('\n');
      w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>Proof of Friendship</title><style>${css}</style><style>body{margin:24px;background:#fff}@page{size:landscape;margin:12mm}</style></head><body>${$('net-certificate').outerHTML}</body></html>`);
      w.document.close();
      w.focus();
      setTimeout(() => w.print(), 300);
    });

    /* ---------- QR arrival (?peer=…) ---------- */
    function addFromParams(params: URLSearchParams) {
      const raw = params.get('peer');
      if (!raw) return;
      const mac = parseMac(raw);
      if (!mac || !store.me) return;
      const s = formatMac(mac);
      if (s === store.me.mac) return;
      if (store.ransom) {
        log(`QR link from ${params.get('n') ?? s} refused: your QR is encrypted. Go talk to them with sound.`, 'err');
        showRansom();
        return;
      }
      upsertLink({ mac: s, nick: params.get('n') ?? '', skill: params.get('s') ?? '', idea: params.get('i') ?? '', via: 'qr', at: Date.now() });
      log(`QR link: ${params.get('n') ?? s}`, 'ok');
      void api.register(store.me).then(() => api.link(store.me!.mac, s, 'qr'));
      showPeer(s, 'เชื่อมผ่าน QR แทนเสียง ก็ยังนับว่าเพื่อนกัน');
    }
    {
      const params = new URLSearchParams(location.search);
      if (params.get('peer')) {
        if (store.me) addFromParams(params);
        else sessionStorage.setItem(PENDING, params.toString());
        for (const k of ['peer', 'n', 's', 'i']) params.delete(k);
        const q = params.toString().replace('skip=', 'skip');
        history.replaceState(null, '', `${location.pathname}${q ? `?${q}` : ''}${location.hash}`);
      }
    }

    /* ---------- lifecycle ---------- */
    const syncOpen = () => {
      const open = !win.hidden && !win.hasAttribute('data-minimized');
      if (!open && modem.listening) stopListening();
      if (!open) alarmOff();
    };
    new MutationObserver(syncOpen).observe(win, { attributes: true, attributeFilter: ['hidden', 'data-minimized'] });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && modem.listening) stopListening();
    });
    window.addEventListener('online', renderStats);
    window.addEventListener('offline', renderStats);
    setInterval(() => void syncFromServer(), 60_000);

    if (store.me) showMain();
    else openWizard();
    log('SHTX-NET ready. Nothing leaves this phone unless a NOC server is configured.', 'info');

    /* Field-debug hook: window.__shtxnet.modem / .node / frame helpers (used by scripts/net-e2e.mjs too) */
    (window as unknown as { __shtxnet: unknown }).__shtxnet = {
      modem,
      get node() {
        return node;
      },
      store,
      encodeFrame,
      decodeFrame,
      encodePcm,
      buildFrame,
      formatMac,
      parseMac,
      ransom: (qr = 42) => startRansom(qr),
      deadpixel: (minutes = 10) => handleDeadPixel({ round: (store.dp?.round ?? 0) + 1, at: Date.now(), deadline: Date.now() + minutes * 60_000, macs: [store.me?.mac ?? ''] }),
    };
  }

  setupNetwork();
</script>
