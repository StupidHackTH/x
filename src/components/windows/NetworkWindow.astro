---
import Window from '../Window.astro';
import Icon from '../Icon.astro';
import { questions, skillSuggestions, LIMITS, CERT_LINKS } from '../../data/network';

// SHTX-NET: the icebreaker. A real 300-baud FSK modem over the phone speaker + mic (src/scripts/fsk.ts), a 3-way
// handshake (src/scripts/netproto.ts), and 2000s business cards. Works phone-to-phone with no server; with
// PUBLIC_SHTX_NET_API set, links also flow to the NOC screen (/noc).
const steps = ['Identity', ...questions.map((q) => q.id.toUpperCase()), 'MAC address'];
---

<Window id="shtxnet" menu={['File', 'Edit', 'View', 'Tools', 'Help']} status="SHTX-NET · 300 baud FSK over the air · half duplex · CSMA/CA" beige>
  <div class="net" id="net" data-view="setup" data-link="idle" data-listen="off">
    <section class="net-wizard" data-pane="setup">
      <header class="net-banner">
        <div>
          <h2>New Connection Wizard</h2>
          <p>ตั้งค่า Network Interface Card ของคุณ จะได้ไปจับมือ (3-way handshake) กับคนอื่นในงาน</p>
        </div>
        <Icon name="shtxnet" class="net-banner-icon" />
      </header>
      <form class="net-wizard-body" id="net-form" novalidate>
        <ol class="net-steps" aria-hidden="true">
          {steps.map((s, i) => <li data-step={i}>{s}</li>)}
        </ol>
        <div class="net-pages">
          <fieldset data-step="0">
            <legend>คุณคือใครในเครือข่ายนี้</legend>
            <p class="net-privacy">เก็บแค่ชื่อเล่น สกิล และไอเดียโง่ ๆ ไม่ต้องใช้ชื่อจริง เบอร์ หรืออีเมล</p>
            <label>ชื่อเล่น (hostname) <input id="net-nick" maxlength={LIMITS.nick} autocomplete="off" placeholder="เช่น โขง" required /></label>
            <label>สกิล / หน้าที่ <input id="net-skill" maxlength={LIMITS.skill} autocomplete="off" list="net-skill-list" placeholder="เช่น Frontend, หาข้าว" required /></label>
            <datalist id="net-skill-list">{skillSuggestions.map((s) => <option value={s} />)}</datalist>
            <label>ไอเดียโง่ ๆ ที่อยากทำในงาน <input id="net-idea" maxlength={LIMITS.idea} autocomplete="off" placeholder="เช่น เว็บที่โหลดช้าลงทุกครั้งที่กด" required /></label>
          </fieldset>
          {questions.map((q, i) => (
            <fieldset data-step={i + 1} hidden>
              <legend>{q.q}</legend>
              <div class="net-options">
                {q.options.map((o, j) => (
                  <label><input type="radio" name={`q${i}`} value={j} /> {o}</label>
                ))}
              </div>
            </fieldset>
          ))}
          <fieldset data-step={questions.length + 1} hidden>
            <legend>Network adapter ของคุณพร้อมแล้ว</legend>
            <div class="net-macbox">
              <div class="net-mac" id="net-new-mac">00:00:00:00:00:00</div>
              <dl>
                <dt>Vendor (OUI)</dt><dd id="net-new-vendor">—</dd>
                <dt>Host name</dt><dd id="net-new-host">—</dd>
                <dt>ICQ#</dt><dd id="net-new-icq">—</dd>
              </dl>
            </div>
            <p class="net-note">MAC address นี้ถอดกลับมาเป็นคำตอบของคุณได้ (3 บิตต่อข้อ) ส่วน 3 ไบต์ท้ายสุ่มมา จะได้ไม่ชนกับคนอื่นอีก 60 คน</p>
          </fieldset>
        </div>
        <footer class="net-wizard-nav">
          <button type="button" class="xp-btn" id="net-back" disabled>&lt; Back</button>
          <button type="button" class="xp-btn" id="net-next">Next &gt;</button>
          <button type="button" class="xp-btn" id="net-finish" hidden>Finish</button>
        </footer>
      </form>
    </section>

    <section class="net-main" data-pane="main" hidden>
      <div class="net-col">
        <div class="net-card me" id="net-mycard">
          <div class="net-card-stripe"></div>
          <div class="net-card-body">
            <div class="net-card-name" id="net-me-nick">—</div>
            <div class="net-card-title" id="net-me-skill">—</div>
            <div class="net-card-idea" id="net-me-idea">—</div>
            <div class="net-card-foot">
              <span>ICQ# <b id="net-me-icq">—</b></span>
              <span>MAC <b id="net-me-mac">—</b></span>
            </div>
          </div>
          <button type="button" class="net-card-edit" id="net-edit" title="แก้นามบัตร">Edit</button>
        </div>

        <div class="net-status">
          <span class="net-status-icon" aria-hidden="true"><Icon name="shtxnet" /><i class="led"></i></span>
          <div class="net-status-text">
            <b id="net-status">Not connected</b>
            <small id="net-substatus">กด Start เพื่อเปิดไมค์และฟังสัญญาณ</small>
          </div>
          <div class="net-meter" title="ระดับเสียงที่ไมค์ได้ยิน"><i id="net-level"></i></div>
          <small class="net-levelnum" id="net-levelnum">—</small>
        </div>

        <div class="net-actions">
          <button type="button" class="xp-btn" id="net-listen">Start listening</button>
          <button type="button" class="xp-btn primary" id="net-connect" disabled>Connect (SYN)</button>
          <button type="button" class="xp-btn" id="net-qr">QR fallback</button>
          <button type="button" class="xp-btn" id="net-manual-btn">Enter MAC…</button>
          <button type="button" class="xp-btn" id="net-ping" disabled title="ส่งเสียงทดสอบ 1 เฟรม">Test tone</button>
          <label class="net-range">ระยะ <select id="net-range">
            <option value="0.08">ใกล้มาก (ชนกัน)</option>
            <option value="0.05" selected>ปกติ (1 ฝ่ามือ)</option>
            <option value="0.02">ไกล (เสียงดัง)</option>
            <option value="0.006">ไมค์เบามาก (iPhone)</option>
          </select></label>
        </div>
        <p class="net-howto">วิธีเล่น: ทั้งสองเครื่องกด <b>Start listening</b> · วางมือถือห่างกันประมาณ 1 ฝ่ามือ เปิดเสียง 40–60% · ฝ่ายหนึ่งกด <b>Connect</b> แล้วรอฟังเสียงโมเด็ม ประมาณ 6 วินาที</p>

        <div class="net-term" id="net-term" role="log" aria-live="polite"></div>
        <div class="net-stats" id="net-stats">TX 0 · RX 0 · CRC errors 0 · far hosts ignored 0 · NOC: offline</div>
      </div>

      <div class="net-col net-col-right">
        <div class="net-contacts-head">
          <h3>Contacts <span id="net-count">(0)</span></h3>
          <button type="button" class="xp-btn" id="net-cert-btn" disabled title={`ครบ ${CERT_LINKS} คนรับใบรับรอง`}>Certificate</button>
        </div>
        <ul class="net-contacts" id="net-contacts"></ul>
        <p class="net-empty" id="net-empty">ยังไม่มีใครในเครือข่าย ลองเดินไปหาคนที่ยังไม่รู้จัก แล้วเอามือถือมาชนกัน</p>
      </div>
    </section>

    <div class="net-overlay" id="net-peer" hidden>
      <div class="net-dialog">
        <h3 class="ok">CONNECTION ESTABLISHED</h3>
        <div class="net-card peer">
          <div class="net-card-stripe"></div>
          <div class="net-card-body">
            <div class="net-card-name" id="net-peer-nick">—</div>
            <div class="net-card-title" id="net-peer-skill">—</div>
            <div class="net-card-idea" id="net-peer-idea">—</div>
            <div class="net-card-foot">
              <span>ICQ# <b id="net-peer-icq">—</b></span>
              <span>MAC <b id="net-peer-mac">—</b></span>
            </div>
          </div>
        </div>
        <ul class="net-traits" id="net-peer-traits"></ul>
        <p class="net-note" id="net-peer-note"></p>
        <div class="net-dialog-btns"><button type="button" class="xp-btn primary" data-close-overlay>Done</button></div>
      </div>
    </div>

    <div class="net-overlay" id="net-qr-overlay" hidden>
      <div class="net-dialog">
        <h3>QR fallback</h3>
        <p>ถ้าเสียงโมเด็มฟังกันไม่รู้เรื่อง (ห้องดังมาก) ให้อีกฝ่ายสแกนด้วยกล้องมือถือปกติ จะเปิดเว็บนี้แล้วเพิ่มคุณเข้า Contacts ให้</p>
        <canvas id="net-qr-canvas" width="240" height="240"></canvas>
        <input id="net-qr-link" readonly />
        <div class="net-dialog-btns"><button type="button" class="xp-btn" id="net-qr-copy">Copy link</button><button type="button" class="xp-btn primary" data-close-overlay>Close</button></div>
      </div>
    </div>

    <div class="net-overlay" id="net-manual" hidden>
      <div class="net-dialog">
        <h3>Connect by MAC address</h3>
        <p>พิมพ์ MAC ของอีกฝ่าย (ดูบนนามบัตรเขา) ต้อง online ถึง NOC ถึงจะดึงนามบัตรมาได้</p>
        <input id="net-manual-mac" placeholder="02:1A:2B:3C:4D:5E" autocomplete="off" spellcheck="false" />
        <p class="net-note err" id="net-manual-err" hidden></p>
        <div class="net-dialog-btns"><button type="button" class="xp-btn" data-close-overlay>Cancel</button><button type="button" class="xp-btn primary" id="net-manual-go">Connect</button></div>
      </div>
    </div>

    <div class="net-ransom" id="net-ransom" hidden role="alertdialog" aria-label="Emergency Alert">
      <div class="net-eas-crawl" aria-hidden="true"><span>▲ EMERGENCY ALERT SYSTEM ▲ THIS IS NOT A TEST ▲ SHTX-NET CIVIL NETWORK AUTHORITY HAS ISSUED A RANSOMWARE WARNING FOR THIS DEVICE ▲ QR ABUSE DETECTED ▲ SEEK HUMAN CONTACT IMMEDIATELY ▲ ประกาศภาวะฉุกเฉิน ▲ เครื่องนี้ติด RANSOMWARE เพราะสแกน QR มากเกินไป ▲ กรุณาเชื่อมต่อด้วยเสียงกับมนุษย์จริง ▲ </span></div>
      <div class="net-eas-body">
        <div class="net-eas-head"><span class="net-eas-tri">⚠</span> EMERGENCY ALERT <span class="net-eas-tri">⚠</span></div>
        <p class="net-eas-sub">THIS IS NOT A TEST · นี่ไม่ใช่การซ้อม</p>
        <div class="net-eas-main">
          <pre class="net-ransom-skull" aria-hidden="true">      _____
     /     \
    | () () |
     \  ^  /
      |||||
      |||||</pre>
          <div>
            <h3>CONGRATULATIONS!</h3>
            <p class="net-ransom-big">YOU ARE SO RANSOMWARE</p>
            <p class="net-eas-text">The SHTX-NET Civil Network Authority has detected <b id="net-ransom-count">?</b> QR connections from this host. That is not networking. That is scanning. Your QR fallback and MAC entry have been encrypted with military-grade 300-baud FSK.</p>
            <p class="net-eas-text">To decrypt, complete <b id="net-ransom-left">3</b> more <b>AIR connections</b> (real acoustic handshakes with real humans) before the deadline. No Bitcoin accepted.</p>
            <p class="net-eas-text th">ให้เอาโทรศัพท์ไปจ่อกับคนจริง ๆ อีก <b id="net-ransom-left-th">3</b> คน แล้วกด Connect ทางเสียง ระบบจะปลดล็อกเอง</p>
          </div>
        </div>
        <div class="net-eas-meta">
          <div><small>TIME REMAINING</small><span class="net-ransom-timer" id="net-ransom-timer">03:59:59</span></div>
          <div><small>WALLET</small><span>1QRsp4mm3rXXXXXXXXXXXXXXXXXXX</span></div>
          <div><small>ISSUED BY</small><span>SHTX-NET NOC · 300 BAUD</span></div>
        </div>
        <button type="button" class="net-ransom-btn" id="net-ransom-ok">I UNDERSTAND · ปิดเสียงเตือน</button>
      </div>
      <div class="net-eas-crawl bottom" aria-hidden="true"><span>▲ EMERGENCY ALERT SYSTEM ▲ THIS IS NOT A TEST ▲ SHTX-NET CIVIL NETWORK AUTHORITY HAS ISSUED A RANSOMWARE WARNING FOR THIS DEVICE ▲ QR ABUSE DETECTED ▲ SEEK HUMAN CONTACT IMMEDIATELY ▲ ประกาศภาวะฉุกเฉิน ▲ เครื่องนี้ติด RANSOMWARE เพราะสแกน QR มากเกินไป ▲ กรุณาเชื่อมต่อด้วยเสียงกับมนุษย์จริง ▲ </span></div>
    </div>
    <div class="net-dead" id="net-dead" hidden role="alertdialog" aria-label="Dead Pixel">
      <i class="net-dead-px" aria-hidden="true"></i>
      <div class="net-dead-body">
        <p class="net-dead-kicker">SHTX-NET NODE HEALTH SERVICE · ROUND <span id="net-dead-round">1</span></p>
        <h3 id="net-dead-title">DEAD PIXEL DETECTED</h3>
        <p class="net-dead-sub" id="net-dead-sub">at (<span id="net-dead-x">0</span>, <span id="net-dead-y">0</span>) · host <span id="net-dead-mac">—</span></p>
        <p class="net-dead-text" id="net-dead-text">Your node was randomly selected for termination. Make <b>1 new AIR connection</b> (a real acoustic handshake) before the countdown ends to stay routable. Otherwise your Proof of Friendship is <b>revoked</b> until you make 2 more.</p>
        <p class="net-dead-text th" id="net-dead-th">node ของคุณถูกสุ่มให้ตาย ไปจ่อมือถือกับคนใหม่ 1 คนแล้วกด Connect ทางเสียงก่อนหมดเวลา ไม่งั้นใบ cert ถูกถอน (คืนได้เมื่อ air link เพิ่มอีก 2)</p>
        <div class="net-dead-timer" id="net-dead-timer">10:00</div>
        <button type="button" class="net-dead-btn" id="net-dead-ok">OK · ไปหาคน</button>
      </div>
    </div>
    <div class="net-overlay" id="net-cert" hidden>
      <div class="net-dialog wide">
        <div class="net-certificate" id="net-certificate">
          <div class="net-cert-inner">
            <p class="net-cert-pre">Stupid Hackathon X · SHTX-NET Certification Authority</p>
            <p class="net-cert-gold-tag">★ GOLD EDITION · 40+ HOSTS ★</p>
            <h2>Proof of Friendship</h2>
            <p class="net-cert-pre">This is to certify that</p>
            <p class="net-cert-name" id="net-cert-name">—</p>
            <p class="net-cert-text">MAC <span id="net-cert-mac">—</span> has successfully completed <b id="net-cert-count">0</b> three-way handshakes with real humans over a 300-baud acoustic link, and is hereby recognised as a <b id="net-cert-rank">Fully Routable Host</b> on SHTX-NET.</p>
            <p class="net-cert-peers" id="net-cert-peers"></p>
            <div class="net-cert-sig">
              <span>Issued <time id="net-cert-date">—</time></span>
              <span class="net-cert-seal" id="net-cert-seal">CSMA/CA<br />APPROVED</span>
              <span>Signed: root@shtx-net</span>
            </div>
          </div>
        </div>
        <div class="net-dialog-btns"><button type="button" class="xp-btn" id="net-cert-print">Print…</button><button type="button" class="xp-btn primary" data-close-overlay>Close</button></div>
      </div>
    </div>
  </div>
</Window>

<style is:global>
  .net { position: relative; display: flex; flex-direction: column; height: 100%; min-height: 0; background: #ece9d8; font-size: 12px; overflow: hidden; }
  .net [data-pane] { display: flex; flex-direction: column; flex: 1; min-height: 0; }
  .net [data-pane][hidden] { display: none; }

  /* ---- wizard ---- */
  .net-banner { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 18px; background: #fff; border-bottom: 1px solid #a0a0a0; }
  .net-banner h2 { font-size: 13px; font-weight: bold; margin: 0 0 2px; }
  .net-banner p { margin: 0; color: #333; }
  .net-banner-icon { width: 44px; height: 44px; flex: none; }
  .net-wizard-body { display: grid; grid-template-columns: 150px 1fr; grid-template-rows: 1fr auto; flex: 1; min-height: 0; }
  .net-steps { grid-row: 1 / span 2; margin: 0; padding: 14px 10px; list-style: none; background: linear-gradient(180deg, #3d6fd6, #1c45a8); color: #cfe0ff; font-size: 11px; display: flex; flex-direction: column; gap: 8px; }
  .net-steps li { padding-left: 14px; position: relative; }
  .net-steps li::before { content: ''; position: absolute; left: 0; top: 4px; width: 7px; height: 7px; border-radius: 50%; background: #8aa8e6; }
  .net-steps li.current { color: #fff; font-weight: bold; }
  .net-steps li.current::before { background: #ffd34d; box-shadow: 0 0 6px #ffd34d; }
  .net-steps li.done::before { background: #5be36a; }
  .net-pages { padding: 16px 20px; overflow: auto; min-height: 0; }
  .net-pages fieldset { border: 0; padding: 0; margin: 0; }
  .net-pages fieldset[hidden] { display: none; }
  .net-pages legend { font-weight: bold; font-size: 13px; margin-bottom: 10px; }
  .net-pages label { display: block; margin: 8px 0; }
  .net-pages input[type='text'], .net-pages input:not([type]) { display: block; width: 100%; max-width: 360px; margin-top: 3px; padding: 3px 5px; border: 1px solid #7f9db9; background: #fff; font: inherit; }
  .net-options label { display: flex; align-items: center; gap: 6px; margin: 6px 0; cursor: pointer; }
  .net-privacy { margin: 0 0 8px; padding: 6px 8px; background: #fff8d6; border: 1px solid #e3cf6d; }
  .net-wizard-nav { grid-column: 2; display: flex; justify-content: flex-end; gap: 6px; padding: 10px 16px; border-top: 1px solid #fff; box-shadow: 0 -1px 0 #a0a0a0; }
  .net-wizard-nav button[hidden] { display: none; }
  .net-macbox { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; padding: 14px; background: #fff; border: 1px solid #a0a0a0; }
  .net-mac { font: bold 26px/1 'Lucida Console', 'Courier New', monospace; letter-spacing: 1px; color: #0a246a; }
  .net-macbox dl { display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; margin: 0; }
  .net-macbox dt { color: #555; }
  .net-macbox dd { margin: 0; font-weight: bold; }
  .net-note { color: #444; margin: 10px 0 0; font-size: 11px; }
  .net-note.err { color: #b00; }
  .net-note[hidden] { display: none; }

  /* ---- main ---- */
  .net-main { flex-direction: row !important; gap: 0; }
  .net-col { display: flex; flex-direction: column; gap: 8px; padding: 10px; min-width: 0; min-height: 0; flex: 1 1 60%; overflow: auto; }
  .net-col-right { flex: 1 1 40%; border-left: 1px solid #a0a0a0; background: #f4f3ee; }
  .net-card { position: relative; background: #fff; border: 1px solid #b9b9b9; box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.15); font-family: Arial, Tahoma, sans-serif; overflow: hidden; }
  .net-card-stripe { height: 10px; background: linear-gradient(90deg, #0a3d91, #1e78d8 50%, #9ad1ff); }
  .net-card.peer .net-card-stripe { background: linear-gradient(90deg, #8a2a00, #e86d16 50%, #ffd27a); }
  .net-card-body { padding: 10px 14px 12px; }
  .net-card-name { font-size: 20px; font-weight: bold; color: #0a246a; letter-spacing: 0.5px; }
  .net-card.peer .net-card-name { color: #6b2600; }
  .net-card-title { font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px; color: #555; margin-top: 2px; }
  .net-card-idea { font-style: italic; color: #333; margin-top: 8px; }
  .net-card-foot { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-top: 10px; padding-top: 6px; border-top: 1px dotted #bbb; font-size: 10px; color: #666; }
  .net-card-foot b { font-family: 'Lucida Console', 'Courier New', monospace; color: #222; }
  .net-card-edit { position: absolute; right: 8px; top: 14px; font-size: 10px; padding: 1px 6px; background: #f3f3f3; border: 1px solid #bbb; cursor: pointer; }
  .net-status { display: flex; align-items: center; gap: 10px; padding: 8px 10px; background: #fff; border: 1px solid #a0a0a0; }
  .net-status-icon { position: relative; width: 36px; height: 36px; flex: none; }
  .net-status-icon .icon { width: 36px; height: 36px; }
  .net-status-icon .led { position: absolute; right: -2px; bottom: -2px; width: 9px; height: 9px; border-radius: 50%; background: #777; border: 1px solid #333; }
  .net[data-listen='on'] .net-status-icon .led { background: #39d353; box-shadow: 0 0 6px #39d353; animation: net-blink 1.2s infinite; }
  .net[data-link='syn_sent'] .net-status-icon .led, .net[data-link='synack_sent'] .net-status-icon .led, .net[data-link='ack_sent'] .net-status-icon .led { background: #ffb300; box-shadow: 0 0 6px #ffb300; animation: net-blink 0.25s infinite; }
  @keyframes net-blink { 50% { opacity: 0.35; } }
  .net-status-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .net-status-text small { color: #555; }
  .net-meter { width: 90px; height: 10px; background: #ddd; border: 1px solid #888; overflow: hidden; flex: none; }
  .net-meter i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #39d353, #ffd34d 70%, #ff4d4d); transition: width 80ms linear; }
  .net-meter[data-busy] { outline: 2px solid #ffb300; }
  .net-levelnum { font: 10px 'Lucida Console', monospace; color: #555; width: 38px; text-align: right; }
  .net-actions { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
