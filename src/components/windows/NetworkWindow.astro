  .net-dead[data-mode='revived'] h3 { color: #8ef5a3; text-shadow: 0 0 18px #2f9e52; }
  .net-dead[data-mode='demoted'] h3 { color: #ff3b3b; text-shadow: 0 0 18px #c00; }
