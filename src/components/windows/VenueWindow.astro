---
import Window from '../Window.astro';
import Icon from '../Icon.astro';
import { venue, showers } from '../../data/event';
---

<Window id="venue" menu={['File', 'Edit', 'View', 'Favorites', 'Tools', 'Help']} status={venue.area} beige>
  <div class="h-full flex flex-col">
    <div class="flex items-center gap-1 px-1 py-1 border-b border-[#fff] bg-xp-beige text-[11px]">
      <span class="px-1">Address</span>
      <div class="xp-sunken flex-1 px-1 py-0.5 truncate"><Icon name="venue" /> {venue.building}</div>
      <a class="xp-btn min-w-0 px-2" href={venue.mapsUrl} target="_blank" rel="noopener">Maps</a>
    </div>
    <div class="p-4 bg-white flex-1 overflow-auto flex flex-col gap-3 text-[12px]">
      <div>
        <h2 class="font-xp-title font-bold text-lg text-[#0046d5]">VENUE · {venue.name}</h2>
        <p class="leading-relaxed">
          <b>{venue.building}</b> ({venue.buildingNote})<br />
          จัดที่ {venue.zone}<br />
          <span class="text-neutral-600">ใกล้: {venue.nearby}</span>
        </p>
        <p class="text-[11px] text-neutral-600 mt-1 flex items-center gap-1"><Icon name="pin" /> ใน Google Maps ค้นหา "{venue.mapsQuery}" ได้เลย</p>
      </div>

      <fieldset class="xp-groupbox">
        <legend>การเดินทาง</legend>
        <ul class="flex flex-col gap-2">
          {venue.transit.map((t) => (
            <li class="flex gap-2">
              <Icon name={t.icon} class="w-6 h-6 shrink-0" />
              <span><b>{t.label}:</b> {t.text}</span>
            </li>
          ))}
        </ul>
      </fieldset>

      <fieldset class="xp-groupbox">
        <legend>ที่อาบน้ำ (venue ไม่มีห้องอาบน้ำ)</legend>
        <p class="text-[11px] text-neutral-600 mb-2">ค้างคืนแล้วอยากอาบน้ำ มีที่อาบน้ำสาธารณะใกล้รถไฟฟ้า ไปกลับก่อนงานวันที่ 2 ได้</p>
        <ul class="flex flex-col gap-2">
          {showers.map((s) => (
            <li class="xp-sunken p-2 flex flex-col gap-0.5">
              <div class="flex flex-wrap items-baseline gap-x-2"><b>{s.name}</b><span class="text-neutral-600">{s.where}</span></div>
              <div><span class="text-neutral-500">เปิด</span> {s.hours} · <span class="text-neutral-500">ราคา</span> {s.price}</div>
              <div><span class="text-neutral-500">โทร</span> {s.phone}{s.note && <> · {s.note}</>}</div>
              <div class="flex flex-wrap gap-x-3">
                <a href={s.mapsUrl} target="_blank" rel="noopener">แผนที่</a>
                <a href={s.infoUrl} target="_blank" rel="noopener">{s.infoLabel}</a>
                {s.bookUrl && <a href={s.bookUrl} target="_blank" rel="noopener">จองผ่าน LINE</a>}
              </div>
            </li>
          ))}
        </ul>
      </fieldset>

      <div class="flex justify-end gap-2 mt-auto">
        <a class="xp-btn default" href={venue.mapsUrl} target="_blank" rel="noopener"><Icon name="venue" /> เปิด Google Maps</a>
        <button type="button" class="xp-btn" data-action="close">Close</button>
      </div>
    </div>
  </div>
</Window>
