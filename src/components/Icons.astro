---
// Vector icon sprite shared by every shell (XP desktop, Mac Dock, iPhone tiles, Android launcher, windows).
// Use <Icon name="…" /> (Icon.astro) or <svg class="icon"><use href="#i-…" /></svg>. All symbols are 64×64.
---

<!-- Not display:none: browsers then refuse to use the gradients and patterns defined inside -->
<svg xmlns="http://www.w3.org/2000/svg" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="ig-gloss" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".75" /><stop offset=".5" stop-color="#fff" stop-opacity=".2" /><stop offset=".51" stop-color="#fff" stop-opacity="0" /></linearGradient>
    <linearGradient id="ig-blue" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7fbdff" /><stop offset="1" stop-color="#1656c9" /></linearGradient>
    <linearGradient id="ig-green" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9ff07a" /><stop offset="1" stop-color="#2f9a2a" /></linearGradient>
    <linearGradient id="ig-red" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff8f7f" /><stop offset="1" stop-color="#cf2a18" /></linearGradient>
    <linearGradient id="ig-gold" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffe98a" /><stop offset="1" stop-color="#d8930a" /></linearGradient>
    <linearGradient id="ig-gray" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f7f7f7" /><stop offset="1" stop-color="#a9adb5" /></linearGradient>
    <linearGradient id="ig-dark" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6b7180" /><stop offset="1" stop-color="#1f232b" /></linearGradient>
    <linearGradient id="ig-pink" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffa6bd" /><stop offset="1" stop-color="#d9366a" /></linearGradient>
    <linearGradient id="ig-purple" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#aeb2ff" /><stop offset="1" stop-color="#5359d1" /></linearGradient>
    <linearGradient id="ig-cyan" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a8ecff" /><stop offset="1" stop-color="#1580cf" /></linearGradient>
    <linearGradient id="ig-fb" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6d8ad6" /><stop offset="1" stop-color="#2f4a8c" /></linearGradient>
    <radialGradient id="ig-lens" cx=".4" cy=".35" r=".7"><stop offset="0" stop-color="#8fd3ff" /><stop offset=".45" stop-color="#1c3f6a" /><stop offset="1" stop-color="#000" /></radialGradient>
    <radialGradient id="ig-screen" cx=".5" cy=".2" r="1"><stop offset="0" stop-color="#8cc4ff" /><stop offset="1" stop-color="#1544a8" /></radialGradient>
    <pattern id="ig-mesh" width="4" height="4" patternUnits="userSpaceOnUse"><path d="M0 4L4 0M-1 1l2-2M3 5l2-2" stroke="#6d7178" stroke-width=".8" /></pattern>
      <linearGradient id="ig-netscreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9fd8ff" /><stop offset="1" stop-color="#1b5fc9" /></linearGradient>
    <linearGradient id="ig-netcase" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f4f4f0" /><stop offset="1" stop-color="#b9b9ad" /></linearGradient>
    <linearGradient id="ig-netglobe" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#bff5a6" /><stop offset="1" stop-color="#1f8f3a" /></linearGradient>
</defs>

  <!-- About: a computer -->
