---
// Live event dashboard: teams registered through Submit Project, check-ins, refunds, SHTX-NET, vote, gacha.
// Public aggregate numbers only (from /api/stats). Refreshes every 10 s. Put it on a second screen or a staff phone.
import { asset } from '../lib/asset';
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>shtX Dashboard</title>
    <link rel="icon" href={asset('favicon-64.png')} />
    <style is:global>
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; }
      body { font: 15px/1.4 Tahoma, 'Segoe UI', 'Noto Sans Thai', sans-serif; color: #e8f2ff; background: radial-gradient(circle at 30% 0%, #2a6be0, #06264f 60%, #031a3d) fixed; padding: 14px; }
      h1 { margin: 0 0 10px; font: bold 22px 'Trebuchet MS', Tahoma, sans-serif; display: flex; align-items: center; gap: 10px; }
      h1 small { font-weight: normal; font-size: 12px; color: #bfe6ff; margin-left: auto; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
      .card { background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 14px; padding: 12px 14px; backdrop-filter: blur(6px); }
      .card h2 { margin: 0 0 8px; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: #bfe6ff; }
      .big { font: bold 44px 'Trebuchet MS', Tahoma, sans-serif; line-height: 1; }
      .big small { font-size: 16px; font-weight: normal; color: #bfe6ff; }
      .row { display: flex; justify-content: space-between; gap: 8px; padding: 4px 0; border-bottom: 1px dashed rgba(255, 255, 255, 0.15); font-size: 13px; }
      .row:last-child { border: 0; }
      .row b { font-variant-numeric: tabular-nums; }
      ol { margin: 0; padding: 0; list-style: none; }
      ol li { display: grid; grid-template-columns: 24px 1fr auto; gap: 8px; padding: 5px 0; border-bottom: 1px dashed rgba(255, 255, 255, 0.15); font-size: 14px; }
      ol li .n { color: #bfe6ff; text-align: right; }
      ol li b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      ol li small { display: block; color: #bfe6ff; font-size: 12px; white-space: normal; margin-top: 1px; }
      .pill { padding: 2px 8px; border-radius: 10px; background: rgba(255, 255, 255, 0.2); font-size: 12px; align-self: start; white-space: nowrap; }
      .teams { grid-column: 1 / -1; }
      .ok { color: #8ef5a3; } .warn { color: #ffd34d; }
      .bar { height: 8px; border-radius: 4px; background: rgba(255, 255, 255, 0.15); overflow: hidden; margin-top: 6px; }
      .bar i { display: block; height: 100%; background: linear-gradient(90deg, #8ef5a3, #2f9e52); }
      .chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 3px; }
      .chip { font-size: 12px; padding: 1px 7px; border-radius: 9px; background: rgba(255, 255, 255, 0.16); white-space: nowrap; }
      .chip.t1 { background: linear-gradient(180deg, #ffd34d, #d68a00); color: #3a2200; font-weight: bold; }
      .chip.t2 { background: rgba(180, 140, 255, 0.6); }
      .gpop { position: fixed; inset: 0; z-index: 50; display: flex; align-items: center; justify-content: center; padding: 24px; background: rgba(2, 12, 34, 0.72); backdrop-filter: blur(4px); cursor: pointer; }
      .gpop[hidden] { display: none; }
      .gpop-box { width: min(760px, 100%); padding: 22px 26px 24px; border-radius: 22px; text-align: center; background: linear-gradient(160deg, rgba(42, 107, 224, 0.95), rgba(6, 38, 79, 0.97)); border: 2px solid rgba(255, 255, 255, 0.5); box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55); animation: gpop-in 0.5s cubic-bezier(0.2, 1.4, 0.4, 1); }
      .gpop-box.sr { border-color: #ffd34d; box-shadow: 0 0 0 4px rgba(255, 211, 77, 0.35), 0 0 60px rgba(255, 211, 77, 0.5), 0 30px 80px rgba(0, 0, 0, 0.55); }
      .gpop-kicker { font-size: 13px; letter-spacing: 4px; color: #bfe6ff; }
      .gpop-team { margin: 4px 0 14px; font: bold clamp(28px, 5vw, 52px) 'Trebuchet MS', Tahoma, sans-serif; line-height: 1.1; }
      .gpop-items { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
      .gpop-item { padding: 8px 14px; border-radius: 14px; font-size: clamp(15px, 2.2vw, 22px); background: rgba(255, 255, 255, 0.14); animation: gpop-item 0.4s backwards; }
      .gpop-item i { font-style: normal; font-size: 0.7em; font-weight: bold; margin-right: 6px; opacity: 0.85; }
      .gpop-item.t1 { background: linear-gradient(180deg, #ffe17a, #d68a00); color: #3a2200; font-weight: bold; }
      .gpop-item.t2 { background: rgba(180, 140, 255, 0.6); }
      .gpop-foot { margin-top: 14px; font-size: 12px; color: #bfe6ff; }
      @keyframes gpop-in { from { transform: scale(0.6) translateY(30px); opacity: 0; } }
      @keyframes gpop-item { from { transform: translateY(12px); opacity: 0; } }
    </style>
  </head>
  <body>
    <h1><img src={asset('favicon-64.png')} width="28" height="28" alt="" /> Stupid Hackathon X · Dashboard <small id="sync">…</small></h1>
    <div class="grid">
      <div class="card"><h2>ทีมที่ลงทะเบียน (Submit Project)</h2><div class="big" id="teams-n">–<small> ทีม</small></div><div class="row"><span>สมาชิกที่กรอกมา</span><b id="teams-m">–</b></div><div class="row"><span>รับสมัคร</span><b id="teams-state">–</b></div></div>
      <div class="card"><h2>เช็คอิน (paid ticket)</h2><div class="big"><span id="ci-n">–</span><small id="ci-of"> / –</small></div><div class="bar"><i id="ci-bar" style="width:0"></i></div><div class="row"><span>staff/sponsor เช็คอิน</span><b id="ci-staff">–</b></div></div>
      <div class="card"><h2>คืนมัดจำ</h2><div class="big"><span id="rf-n">–</span><small id="rf-of"> / –</small></div><div class="row"><span>คืนแล้ว</span><b id="rf-baht">–</b></div><div class="row"><span>ยังต้องคืน</span><b id="rf-left">–</b></div></div>
      <div class="card"><h2>SHTX-NET</h2><div class="big" id="net-h">–<small> hosts</small></div><div class="row"><span>links ทั้งหมด</span><b id="net-l">–</b></div><div class="row"><span>air links</span><b id="net-a">–</b></div></div>
      <div class="card"><h2>โหวต / กาชา / Logo Hunting</h2><div class="row"><span>Popular vote</span><b id="vote">–</b></div><div class="row"><span>Most Stupid Project</span><b id="vote2">–</b></div><div class="row"><span>กาชาหมุนแล้ว</span><b id="gacha">–</b></div><div class="row"><span>Logo Hunting เล่น / ครบ 6</span><b id="hunt">–</b></div></div>
      <div class="card"><h2>Live vote</h2><div id="lv-active" class="row" style="border:0"><span>บนเวที</span><b id="lv-name">–</b></div><div class="big" id="lv-score" style="font-size:36px">–</div><ol id="lv"></ol></div>
      <div class="card" id="gl-card" hidden><h2>Gacha log <span id="gl-state"></span></h2><ol id="gl"></ol></div>
      <div class="card"><h2>เช็คอินล่าสุด</h2><ol id="last"></ol></div>
      <div class="card teams"><h2>คิว pitching</h2><ol id="teams"></ol></div>
    </div>
    <div class="gpop" id="gpop" hidden role="dialog" aria-live="polite"><div class="gpop-box" id="gpop-box"><div class="gpop-kicker">🎰 GACHA PULL</div><div class="gpop-team" id="gpop-team"></div><div class="gpop-items" id="gpop-items"></div><div class="gpop-foot" id="gpop-foot"></div></div></div>
    <script>
      import { apiBase } from '../scripts/netapi';
      const $ = (id: string) => document.getElementById(id)!;
      const t = (ms: number) => new Date(ms).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
      async function load() {
        try {
          const r = await fetch(`${apiBase()}/api/stats`, { cache: 'no-store' });
          if (!r.ok) throw new Error(String(r.status));
          const s = await r.json();
          $('teams-n').innerHTML = `${s.teams.length}<small> ทีม</small>`;
          $('teams-m').textContent = String(s.teams.reduce((n: number, x: { members: number }) => n + x.members, 0));
          $('teams-state').innerHTML = s.vote.submitClosed ? '<span class="warn">ปิดรับแล้ว</span>' : '<span class="ok">เปิดอยู่ (ปิด 11:50)</span>';
          $('ci-n').textContent = s.attendees.checked; $('ci-of').textContent = ` / ${s.attendees.paid}`;
          ($('ci-bar') as HTMLElement).style.width = `${s.attendees.paid ? Math.round((100 * s.attendees.checked) / s.attendees.paid) : 0}%`;
          $('ci-staff').textContent = s.attendees.staffChecked;
          $('rf-n').textContent = s.attendees.refunded; $('rf-of').textContent = ` / ${s.attendees.paid}`;
          $('rf-baht').textContent = `฿${s.attendees.refundedBaht.toLocaleString()}`; $('rf-left').textContent = `฿${s.attendees.toRefundBaht.toLocaleString()}`;
          $('net-h').innerHTML = `${s.net.hosts}<small> hosts</small>`; $('net-l').textContent = s.net.links; $('net-a').textContent = s.net.air;
          $('vote').innerHTML = s.vote.link ? `<span class="ok">เปิดลิงก์แล้ว</span>` : 'ยังไม่ตั้งลิงก์';
          $('vote2').innerHTML = s.vote.open ? '<span class="ok">เปิดโหวต</span>' : 'ปิด';
          $('gacha').textContent = `${s.gacha.pulls} ครั้ง · ${s.gacha.drawn} ชิ้น`;
          $('hunt').textContent = `${s.hunt.players} / ${s.hunt.finished}`;
          $('last').replaceChildren(...s.attendees.lastCheckins.map((c: { name: string; at: number }) => { const li = document.createElement('li'); li.innerHTML = `<span class="n">${t(c.at)}</span><b></b><span></span>`; li.querySelector('b')!.textContent = c.name; return li; }));
          $('teams').replaceChildren(...s.teams.map((x: { order: number; team: string; project: string; members: number; needs: string; at: number }) => { const li = document.createElement('li'); li.innerHTML = `<span class="n">${x.order}</span><b></b><span class="pill"></span>`; li.querySelector('b')!.innerHTML = `${x.team.replace(/</g, '&lt;')}<small></small>`; li.querySelector('small')!.textContent = `${x.project} · ส่ง ${t(x.at)}${x.needs && x.needs !== '-' ? ` · ${x.needs}` : ''}`; li.querySelector('.pill')!.textContent = `${x.members || '?'} คน`; return li; }));
          $('sync').textContent = `อัปเดต ${t(s.at)} · ทุก 10 วิ`;
          const vr = await fetch(`${apiBase()}/api/vote/board`, { cache: 'no-store' }).catch(() => null);
          const vb = vr?.ok ? await vr.json().catch(() => ({})) : {};
          if (vb.session) {
            $('lv-name').textContent = vb.activeTeam ? vb.activeTeam.name : 'ยังไม่มีทีมขึ้นเวที';
            $('lv-score').textContent = vb.activeTeam ? `${vb.activeTeam.totalScore > 0 ? '+' : ''}${vb.activeTeam.totalScore} (${vb.activeTeam.voteCount} โหวต)` : `${vb.session.name}`;
            $('lv').replaceChildren(...[...vb.teams].sort((x: { totalScore: number }, y: { totalScore: number }) => y.totalScore - x.totalScore).slice(0, 5).map((x: { name: string; totalScore: number; voteCount: number }, i: number) => { const li = document.createElement('li'); li.innerHTML = `<span class="n">${i + 1}</span><b></b><span class="pill"></span>`; li.querySelector('b')!.textContent = x.name; li.querySelector('.pill')!.textContent = `${x.totalScore > 0 ? '+' : ''}${x.totalScore} · ${x.voteCount}`; return li; }));
          } else { $('lv-name').textContent = 'ยังไม่เริ่ม session'; $('lv-score').textContent = '–'; $('lv').replaceChildren(); }
        } catch (e) { $('sync').textContent = `โหลดไม่ได้ (${(e as Error).message})`; }
      }
      void load();
      setInterval(() => void load(), 10_000);

      /* Gacha pop-up: every new stage pull pops up full screen for a few seconds (team + prizes) and lands in the Gacha
         log card. The pull log is staff-only on the server, so this runs only in a browser logged in as staff
         (/x/login/ or ?admin=…); the public dashboard just doesn't show it. */
      type GPrize = { id: string; name: string; tier: 'T1' | 'T2' | 'T3' };
      type GPull = { id: number; team: string; prizes: string[]; at: number; claimed: boolean };
      const ADMIN_KEY = 'shtx-noc-admin';
      const token = (() => {
        try {
          const q = new URLSearchParams(location.search);
          const a = q.get('admin');
          if (a !== null) { a ? localStorage.setItem(ADMIN_KEY, a) : localStorage.removeItem(ADMIN_KEY); q.delete('admin'); history.replaceState(null, '', `${location.pathname}${q.size ? `?${q}` : ''}`); }
          return localStorage.getItem(ADMIN_KEY) ?? '';
        } catch { return ''; }
      })();
      const rank = { T1: 0, T2: 1, T3: 2 };
      let gPrizes = new Map<string, GPrize>();
      let gSeen = -1; // highest pull id already shown (-1 = first load: don't pop up history)
      const queue: GPull[] = [];
      let popping = false;
      const of = (id: string): GPrize => gPrizes.get(id) ?? { id, name: id, tier: 'T3' };
      const sorted = (ids: string[]) => [...ids].sort((a, b) => rank[of(a).tier] - rank[of(b).tier]);
      function nextPop() {
        const p = queue.shift();
        if (!p) { popping = false; $('gpop').hidden = true; return; }
        popping = true;
        const ids = sorted(p.prizes);
        $('gpop-team').textContent = p.team;
        $('gpop-box').classList.toggle('sr', ids.some((id) => of(id).tier === 'T1'));
        $('gpop-items').replaceChildren(...ids.map((id, i) => { const z = of(id); const el = document.createElement('span'); el.className = `gpop-item ${z.tier.toLowerCase()}`; el.style.animationDelay = `${0.25 + i * 0.12}s`; el.innerHTML = `<i>${z.tier}</i>`; el.append(z.name); return el; }));
        $('gpop-foot').textContent = `${ids.length} ชิ้น · ${t(p.at)}${queue.length ? ` · ต่อไปอีก ${queue.length} ทีม` : ''}`;
        $('gpop').hidden = false;
        // restart the entrance animation for back-to-back pulls
        const box = $('gpop-box'); box.style.animation = 'none'; void box.offsetWidth; box.style.animation = '';
        clearTimeout((window as unknown as { __gpopT?: number }).__gpopT);
        (window as unknown as { __gpopT?: number }).__gpopT = window.setTimeout(nextPop, 6000 + ids.length * 600);
      }
      $('gpop').addEventListener('click', () => nextPop());
      async function loadGacha() {
        if (!token) return;
        const q = `token=${encodeURIComponent(token)}`;
        const [pr, lg] = await Promise.all([fetch(`${apiBase()}/api/gacha/prizes?${q}`, { cache: 'no-store' }).catch(() => null), fetch(`${apiBase()}/api/gacha/log?${q}`, { cache: 'no-store' }).catch(() => null)]);
        if (!lg?.ok) return;
        if (pr?.ok) gPrizes = new Map(((await pr.json()) as { prizes: GPrize[] }).prizes.map((p) => [p.id, p]));
        const pulls = ((await lg.json()) as { pulls: GPull[] }).pulls.sort((a, b) => a.id - b.id);
        $('gl-card').hidden = false;
        $('gl-state').textContent = pulls.length ? `· ${new Set(pulls.map((p) => p.team)).size} ทีม · ${pulls.reduce((n, p) => n + p.prizes.length, 0)} ชิ้น` : '';
        $('gl').replaceChildren(...(pulls.length ? [...pulls].reverse().slice(0, 6).map((p) => {
          const li = document.createElement('li');
          li.innerHTML = `<span class="n">${t(p.at)}</span><b></b><span class="pill"></span>`;
          const b = li.querySelector('b')!;
          b.textContent = p.team;
          const chips = document.createElement('div'); chips.className = 'chips';
          chips.append(...sorted(p.prizes).map((id) => { const z = of(id); const c = document.createElement('span'); c.className = `chip ${z.tier.toLowerCase()}`; c.textContent = `${z.tier} ${z.name}`; return c; }));
          b.append(chips); b.style.whiteSpace = 'normal';
          li.querySelector('.pill')!.textContent = p.claimed ? '✓ รับแล้ว' : `${p.prizes.length} ชิ้น`;
          return li;
        }) : [Object.assign(document.createElement('li'), { textContent: 'ยังไม่มีใครกด pull' })]));
        const maxId = pulls.length ? pulls[pulls.length - 1].id : 0;
        if (gSeen < 0) gSeen = maxId;
        else if (maxId < gSeen) gSeen = maxId; // log was reset
        const fresh = pulls.filter((p) => p.id > gSeen);
        if (fresh.length) { gSeen = maxId; queue.push(...fresh); if (!popping) nextPop(); }
      }
      if (token) {
        void loadGacha();
        setInterval(() => void loadGacha(), 10_000);
        const live = () => {
          try {
            const ws = new WebSocket(`${apiBase().replace(/^http/, 'ws')}/api/live`);
            ws.onmessage = (m) => { try { if (JSON.parse(m.data).type === 'gacha') void loadGacha(); } catch { /* ignore */ } };
            ws.onclose = () => setTimeout(live, 3000);
          } catch { setTimeout(live, 5000); }
        };
        live();
        (window as unknown as { __gpop: () => void }).__gpop = () => { queue.push({ id: 0, team: 'ทดสอบ pop-up', prizes: [...gPrizes.keys()].slice(0, 4), at: Date.now(), claimed: false }); if (!popping) nextPop(); };
      }
    </script>
  </body>
</html>
