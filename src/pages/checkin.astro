---
// Staff check-in desk: the Eventpop attendee list lives on the NOC server; check-in and the ฿300 deposit refund are
// toggled here from any staff phone and stay in sync. Logic in src/scripts/checkin.ts.
import { asset } from '../lib/asset';
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>shtX Check-in</title>
    <link rel="icon" href={asset('favicon-64.png')} />
    <style is:global>
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; }
      body { font: 15px/1.4 Tahoma, 'Segoe UI', 'Noto Sans Thai', sans-serif; color: #0b2a5b; background: linear-gradient(180deg, #2a6be0 0%, #5aa2f5 40%, #bfe3ff 100%) fixed; -webkit-tap-highlight-color: transparent; }
      [hidden] { display: none !important; }
      .xpwin { max-width: 720px; margin: 0 auto; background: #ece9d8; border: 1px solid #0831d9; border-radius: 8px 8px 4px 4px; box-shadow: 0 0 0 1px #3a6ff0 inset, 0 18px 50px rgba(0, 20, 60, 0.45); overflow: hidden; }
      .xpwin-title { display: flex; align-items: center; gap: 8px; padding: 6px 8px; color: #fff; font: bold 14px 'Trebuchet MS', Tahoma, sans-serif; text-shadow: 1px 1px #0a1f6e; background: linear-gradient(180deg, #0997ff 0%, #0053ee 8%, #0050ee 40%, #06f 88%, #0053ee 94%, #0039c6 100%); position: sticky; top: 0; z-index: 2; }
      .xpwin-title img { width: 20px; height: 20px; }
      .xpwin-title .sp { margin-left: auto; font-weight: normal; font-size: 12px; opacity: 0.9; }
      .lock { padding: 24px 18px; display: flex; flex-direction: column; gap: 10px; background: #fff; }
      .lock input { padding: 8px; border: 1px solid #7f9db9; font: inherit; }
      .lock-msg { min-height: 1.2em; color: #c00; font-size: 13px; }
      .xpbtn { padding: 6px 12px; border: 1px solid #003c74; border-radius: 3px; font: inherit; font-size: 13px; color: #000; cursor: pointer; background: linear-gradient(180deg, #fff 0%, #ecebe6 86%, #d6d0c5 100%); box-shadow: inset 0 -1px #c5c1b3; }
      .xpbtn:hover { box-shadow: inset 0 0 0 2px #f8b636; }
      .xpbtn[aria-pressed='true'] { background: linear-gradient(180deg, #ffd27a, #e0901a); }
      .xpbtn.on { background: linear-gradient(180deg, #a8e59a, #3fb31b); color: #063; font-weight: bold; }
      .bar { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 10px; background: #f1efe2; border-bottom: 1px solid #c8c8c8; position: sticky; top: 33px; z-index: 2; }
      .bar input[type='search'] { flex: 1 1 160px; padding: 8px 10px; border: 1px solid #7f9db9; font: inherit; font-size: 16px; }
      .bar select { padding: 6px 8px; border: 1px solid #7f9db9; font: inherit; font-size: 13px; background: #fff; }
      .counts { display: flex; flex-wrap: wrap; gap: 6px 14px; padding: 6px 12px; font-size: 12px; color: #333; background: #fffbe6; border-bottom: 1px solid #e6dca8; }
      .counts b { color: #0b2a5b; }
      .list { background: #fff; }
      .row { display: grid; grid-template-columns: 1fr auto; gap: 4px 8px; padding: 9px 12px; border-bottom: 1px solid #e5e5e5; align-items: center; }
      .row.c { background: #f0fbee; }
      .row.r { background: #eef4ff; }
      .row b { font-size: 15px; }
      .row small { display: block; color: #555; font-size: 12px; }
      .row .acts { display: flex; gap: 6px; }
      .row .acts .xpbtn { min-width: 76px; font-size: 12px; padding: 7px 8px; }
      .empty { padding: 22px; text-align: center; color: #666; }
      .foot { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 8px 12px; font-size: 12px; color: #444; background: #ece9d8; border-top: 1px solid #c8c8c8; }
      .foot input[type='file'] { font-size: 12px; max-width: 220px; }
      .msg { color: #0b7a2a; font-size: 12px; }
    </style>
  </head>
  <body>
    <main class="xpwin">
      <div class="xpwin-title"><img src={asset('favicon-64.png')} alt="" />Check-in Desk<span class="sp" id="sync"></span></div>
      <section class="lock" id="lock">
        <p style="margin:0">ใส่รหัส staff (รหัสเดียวกับ NOC)</p>
        <form id="lock-form" style="display:flex;gap:8px"><input id="lock-pass" type="password" autocomplete="current-password" required style="flex:1" /><button class="xpbtn" type="submit">เข้า</button></form>
        <p class="lock-msg" id="lock-msg"></p>
      </section>
      <section id="desk" hidden>
        <div class="bar">
          <input id="q" type="search" placeholder="ค้นชื่อ / อีเมล / โทร / Ref / Order" autocomplete="off" />
          <button class="xpbtn" data-f="todo" aria-pressed="true">ยังไม่เช็คอิน</button>
          <button class="xpbtn" data-f="checked">เช็คอินแล้ว</button>
          <button class="xpbtn" data-f="refund">รอคืนมัดจำ</button>
          <button class="xpbtn" data-f="all">ทั้งหมด</button>
          <button class="xpbtn" id="paidonly" aria-pressed="true" title="แสดงเฉพาะบัตรที่จ่ายเงิน (ไม่รวม staff/sponsor)">เฉพาะ paid ticket</button>
          <select id="sort" title="เรียงตาม">
            <option value="name">เรียง: ชื่อ</option>
            <option value="ticket">เรียง: ประเภทบัตร</option>
            <option value="checked">เรียง: เวลาเช็คอิน</option>
            <option value="paid">เรียง: ยอดจ่าย</option>
            <option value="pos">เรียง: ลำดับ Eventpop</option>
          </select>
        </div>
        <div class="counts" id="counts"></div>
        <div class="list" id="list"></div>
        <div class="foot">
          <label>นำเข้า Eventpop CSV ใหม่ (attendees export): <input id="csv" type="file" accept=".csv,text/csv" /></label>
          <a class="xpbtn" id="export" href="#" download>Export CSV</a>
          <button class="xpbtn" id="logout" type="button">Log off</button>
          <span class="msg" id="msg"></span>
        </div>
      </section>
    </main>
    <script src="../scripts/checkin.ts"></script>
  </body>
</html>
