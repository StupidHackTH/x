---
// SHTX-NET Network Operations Center: the stage screen. Frutiger Aero, live mesh graph from the NOC server
// (PUBLIC_SHTX_NET_API or ?api=…), otherwise a 60-host demo so the screen is never empty. Noindex: it is for the venue.
import { asset } from '../lib/asset';
import Icons from '../components/Icons.astro';
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>SHTX-NET NOC</title>
    <link rel="icon" href={asset('favicon-64.png')} />
    <style is:global>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; }
      body { font: 14px/1.4 'Segoe UI', Tahoma, 'Noto Sans Thai', sans-serif; color: #eaf6ff; background: radial-gradient(ellipse at 20% 0%, #9fe3ff 0%, #2b8fe6 28%, #0a3f8f 65%, #031a3d 100%) fixed; overflow: hidden; }
      .noc { display: grid; grid-template-rows: auto 1fr auto; height: 100vh; gap: 10px; padding: 12px 14px; }
      .glass { background: linear-gradient(180deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.08) 45%, rgba(255, 255, 255, 0.04)); border: 1px solid rgba(255, 255, 255, 0.45); border-radius: 12px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 10px 30px rgba(0, 20, 60, 0.35); backdrop-filter: blur(6px); }
      .noc-top { display: flex; align-items: center; gap: 16px; padding: 10px 16px; }
      .noc-top img { width: 46px; height: 46px; filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4)); }
      .noc-title b { display: block; font-size: 20px; letter-spacing: 0.5px; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5); }
      .noc-title small { color: #cfeeff; }
      .noc-pills { margin-left: auto; display: flex; gap: 10px; flex-wrap: wrap; }
      .pill { min-width: 96px; padding: 6px 12px; border-radius: 20px; text-align: center; background: linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.15)); border: 1px solid rgba(255, 255, 255, 0.6); color: #06264f; box-shadow: inset 0 1px 0 #fff; }
      .pill b { display: block; font-size: 20px; line-height: 1.1; font-variant-numeric: tabular-nums; }
      .pill small { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; }
      .pill.alert { background: linear-gradient(180deg, #ffd27a, #e0901a); }
      .noc-btn { padding: 6px 12px; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.6); background: linear-gradient(180deg, rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.1)); color: #fff; font: inherit; cursor: pointer; }
      .noc-btn[aria-pressed='true'] { background: linear-gradient(180deg, #a6f5a6, #37b24d); color: #063; }
      .noc-mid { display: grid; grid-template-columns: 1fr 340px; gap: 10px; min-height: 0; }
      .noc-graph { position: relative; overflow: hidden; }
      .noc-graph canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
      .noc-legend { position: absolute; left: 14px; bottom: 12px; font-size: 12px; color: #dff3ff; display: flex; gap: 14px; padding: 4px 10px; border-radius: 10px; background: rgba(3, 26, 61, 0.55); }
      .noc-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; vertical-align: -1px; margin-right: 5px; }
      .noc-demo { position: absolute; right: 14px; top: 12px; padding: 3px 10px; border-radius: 10px; background: rgba(255, 180, 0, 0.85); color: #3b2400; font-weight: bold; font-size: 12px; letter-spacing: 1px; }
      .noc-demo[hidden] { display: none; }
      .noc-login { position: absolute; right: 14px; top: 74px; z-index: 20; display: flex; align-items: center; gap: 8px; padding: 10px 14px; font-size: 13px; }
      .noc-login[hidden] { display: none; }
      .noc-login input { width: 180px; padding: 5px 8px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.6); background: rgba(255, 255, 255, 0.9); color: #06264f; font: inherit; }
      .noc-login #noc-login-msg { color: #ffb3b3; }
      .noc-paused { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 15; padding: 18px 40px; border-radius: 16px; background: rgba(3, 26, 61, 0.8); border: 2px solid #ffd34d; color: #fff; text-align: center; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5); }
      .noc-paused b { display: block; font-size: 64px; letter-spacing: 8px; color: #ffd34d; line-height: 1; }
      .noc-paused span { font-size: 18px; }
      .noc-paused[hidden] { display: none; }
      .noc-admin .noc-btn[aria-pressed='true'] { background: linear-gradient(180deg, #ffd27a, #e0901a); color: #3b2400; }
      .noc-hints { position: absolute; left: 14px; top: 60px; z-index: 16; width: min(92%, 640px); padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; font-size: 13px; }
      .noc-hints[hidden] { display: none; }
      .noc-hints label { display: grid; grid-template-columns: 170px 1fr; gap: 8px; align-items: center; }
      .noc-hints input { padding: 5px 8px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.6); background: rgba(255, 255, 255, 0.9); color: #06264f; font: inherit; }
      .noc-ransom { position: absolute; right: 14px; top: 44px; display: flex; align-items: center; gap: 10px; padding: 6px 12px; border-radius: 10px; background: #000; border: 2px solid #ff3b3b; color: #ff6b6b; font: 13px 'Lucida Console', 'Courier New', monospace; box-shadow: 0 0 18px rgba(255, 59, 59, 0.6); }
      .noc-ransom b { color: #ff3b3b; letter-spacing: 2px; animation: noc-blink 0.7s steps(2) infinite; }
      .noc-ransom[hidden] { display: none; }
      .noc-dead { position: absolute; left: 14px; top: 44px; display: flex; align-items: center; gap: 10px; padding: 6px 12px; border-radius: 10px; background: #000; border: 2px solid #ddd; color: #ddd; font: 13px 'Lucida Console', 'Courier New', monospace; box-shadow: 0 0 18px rgba(255, 255, 255, 0.35); max-width: 60%; }
      .noc-dead b { letter-spacing: 2px; color: #fff; text-shadow: 2px 0 #f0f, -2px 0 #0ff; animation: noc-blink 1.4s steps(2) infinite; }
      .noc-dead s { color: #888; }
      .noc-dead i { color: #8ef5a3; font-style: normal; }
      .noc-dead[hidden] { display: none; }
      .panel.bingo li .deg { min-width: 54px; text-align: center; }
      .noc-award { position: absolute; inset: 0; z-index: 14; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 50% 40%, rgba(255, 211, 77, 0.25), rgba(3, 26, 61, 0.75) 70%); }
      .noc-award[hidden] { display: none; }
      .noc-award-card { min-width: min(80%, 760px); padding: 28px 40px 32px; border-radius: 18px; background: linear-gradient(180deg, #fffdf3, #f3e7bd); border: 6px double #b8860b; color: #3b2400; text-align: center; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6); animation: noc-award-in 0.4s ease-out; }
      .noc-award-card.place { background: linear-gradient(135deg, #fff8d6, #ffe9a8 40%, #f6d87a); border-color: #c9a227; }
      .noc-award-kicker { font-size: 16px; letter-spacing: 6px; color: #8a6a12; }
      .noc-award-name { margin-top: 10px; font-size: clamp(40px, 6vw, 84px); font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }
      .noc-award-name.spin { color: #8a6a12; }
      .noc-award-arrow { font-size: 26px; color: #b8860b; margin: 4px 0; }
      .noc-award-item { font-size: clamp(28px, 4vw, 56px); font-weight: 700; }
      .noc-award-sub { margin-top: 8px; font-size: 18px; color: #6b5a2a; }
      @keyframes noc-award-in { from { transform: scale(0.85); opacity: 0; } }
      .adm-group { display: inline-flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 4px 6px; border-radius: 10px; background: rgba(255, 255, 255, 0.12); }
      .adm-group select { padding: 4px 6px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.6); background: rgba(255, 255, 255, 0.9); color: #06264f; font: inherit; max-width: 140px; }
      .panel.awards li b.c { text-decoration: line-through; opacity: 0.6; }
      .panel.votelink { display: flex; flex-direction: column; align-items: center; flex: none; }
      .panel.votelink canvas { background: #fff; padding: 6px; border-radius: 8px; width: 180px; height: 180px; }
      .votelink-url { margin-top: 6px; font: 11px 'Lucida Console', monospace; color: #d4f1ff; word-break: break-all; text-align: center; }
      @keyframes noc-blink { 50% { opacity: 0.25; } }
      .noc-admin { position: absolute; left: 14px; top: 12px; display: flex; align-items: center; gap: 8px; padding: 6px 10px; font-size: 12px; }
      .noc-admin[hidden] { display: none; }
      .noc-admin .noc-btn { padding: 3px 10px; font-size: 12px; }
      .noc-admin .noc-btn.danger { background: linear-gradient(180deg, #ffb3b3, #d9534f); color: #fff; }
      .noc-admin input { width: 170px; padding: 3px 8px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.6); background: rgba(255, 255, 255, 0.85); color: #06264f; font: inherit; font-size: 12px; }
      .noc-admin #adm-msg { color: #fff3b0; }
      .noc-side { display: flex; flex-direction: column; gap: 10px; min-height: 0; overflow: hidden; }
      .panel { padding: 10px 14px; min-height: 0; flex: 0 1 auto; overflow: hidden; } /* panels shrink and clip their rows instead of overlapping when many are visible */
      .panel[hidden] { display: none; }
      .panel h3 { margin: 0 0 6px; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: #d4f1ff; }
      .panel ol, .panel ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
      .panel li { display: flex; align-items: center; gap: 8px; font-size: 13px; }
      .panel li .n { width: 18px; color: #bfe6ff; text-align: right; font-variant-numeric: tabular-nums; }
      .panel li b { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .panel li .deg { padding: 0 8px; border-radius: 10px; background: rgba(255, 255, 255, 0.3); font-variant-numeric: tabular-nums; }
      .panel li .mac { font: 10px 'Lucida Console', monospace; color: #bfe6ff; }
      .panel.vote li { display: grid; grid-template-columns: 18px 1fr 34px; gap: 8px; align-items: center; }
      .panel.vote li b { position: relative; padding: 3px 8px; border-radius: 6px; overflow: hidden; }
      .panel.vote li b i { position: absolute; left: 0; top: 0; bottom: 0; background: linear-gradient(90deg, rgba(255, 211, 77, 0.55), rgba(255, 140, 0, 0.35)); border-radius: 6px; z-index: 0; transition: width 0.6s; }
      .panel.vote li b span { position: relative; z-index: 1; }
      .panel.vote li .deg { text-align: center; }
      .panel.vote li.win b { box-shadow: 0 0 0 2px #ffd34d inset; }
      .hunt-keys { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 6px; }
      .hunt-key { padding: 6px 8px; border-radius: 8px; background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.35); font-size: 11px; line-height: 1.25; }
      .hunt-key b { display: block; font-size: 18px; font-variant-numeric: tabular-nums; }
      .hunt-key.found { background: rgba(166, 245, 166, 0.35); border-color: #a6f5a6; }
      .hunt-done { font-size: 12px; color: #dff3ff; }
      .hunt-done b { color: #fff3b0; }
      .idea { flex: 1; display: flex; flex-direction: column; justify-content: center; text-align: center; }
      .idea blockquote { margin: 4px 0; font-size: 20px; line-height: 1.3; font-style: italic; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4); }
      .idea cite { font-style: normal; color: #cfeeff; font-size: 12px; }
      .noc-ticker { overflow: hidden; padding: 8px 0; white-space: nowrap; font: 13px 'Lucida Console', 'Courier New', monospace; color: #b9ffc9; }
      .noc-ticker div { display: inline-block; padding-left: 100%; animation: ticker 40s linear infinite; }
      @keyframes ticker { to { transform: translateX(-100%); } }
      .noc-ticker span { margin-right: 48px; }
      .noc-ticker span.err { color: #ffb3b3; }
      .noc-bsod { position: fixed; inset: 0; background: #0000aa; color: #fff; font: 16px/1.5 'Lucida Console', 'Courier New', monospace; padding: 60px 80px; z-index: 50; white-space: pre-wrap; }
      .noc-bsod[hidden] { display: none; }
      @media (max-width: 900px) { .noc-mid { grid-template-columns: 1fr; } .noc-side { display: none; } .noc-pills .pill { min-width: 70px; } }
    </style>
  </head>
  <body data-api={import.meta.env.PUBLIC_SHTX_NET_API ?? ''}>
    <Icons />
    <div class="noc">
      <header class="noc-top glass">
        <img src={asset('logo-transparent.png')} alt="" />
        <div class="noc-title"><b>SHTX-NET Network Operations Center</b><small>Stupid Hackathon X · 300 baud acoustic mesh · <span id="noc-clock">--:--:--</span></small></div>
        <div class="noc-pills">
          <div class="pill"><b id="st-hosts">0</b><small>Hosts</small></div>
          <div class="pill"><b id="st-links">0</b><small>Links</small></div>
          <div class="pill"><b id="st-packets">0</b><small>Packets</small></div>
          <div class="pill alert"><b id="st-crc">0</b><small>CRC errors</small></div>
          <div class="pill"><b id="st-uptime">0:00</b><small>Uptime</small></div>
        </div>
        <button type="button" class="noc-btn" id="noc-sound" aria-pressed="false">Sound: off</button>
        <button type="button" class="noc-btn" id="noc-full">Full screen</button>
        <button type="button" class="noc-btn" id="noc-staff">Staff</button>
      </header>
      <form class="noc-login glass" id="noc-login" hidden>
        <label for="noc-pass">รหัสผ่านทีมงาน</label>
        <input id="noc-pass" type="password" autocomplete="current-password" />
        <button type="submit" class="noc-btn">Log in</button>
        <button type="button" class="noc-btn" id="noc-login-cancel">Cancel</button>
        <span id="noc-login-msg"></span>
      </form>
      <div class="noc-mid">
        <section class="noc-graph glass">
          <canvas id="noc-canvas"></canvas>
          <div class="noc-legend"><span><i style="background:#8ef5a3"></i>host</span><span><i style="background:#ffd34d"></i>core switch (5+ links)</span><span><i style="background:#ff7b7b"></i>isolated</span></div>
          <div class="noc-demo" id="noc-demo" hidden>DEMO DATA</div>
          <div class="noc-ransom" id="noc-ransom" hidden><b>RANSOMWARE</b><span id="noc-ransom-text"></span></div>
          <div class="noc-dead" id="noc-dead" hidden><b>DEAD PIXEL</b><span id="noc-dead-text"></span></div>
          <div class="noc-award" id="noc-award" hidden>
            <div class="noc-award-card" id="noc-award-card">
              <div class="noc-award-kicker" id="noc-award-kicker">LUCKY DRAW</div>
              <div class="noc-award-name" id="noc-award-name">…</div>
              <div class="noc-award-arrow">▼</div>
              <div class="noc-award-item" id="noc-award-item">…</div>
              <div class="noc-award-sub" id="noc-award-sub"></div>
            </div>
          </div>
          <form class="noc-hints glass" id="noc-hints" hidden>
            <b>คำใบ้ Logo Hunting (แก้แล้วมือถือทุกเครื่องอัปเดตภายใน 1 นาที)</b>
            <div id="noc-hints-rows"></div>
            <div><button type="submit" class="noc-btn">Save</button> <button type="button" class="noc-btn" id="noc-hints-cancel">Cancel</button> <span id="noc-hints-msg"></span></div>
          </form>
          <div class="noc-paused" id="noc-paused" hidden><b>PAUSED</b><span id="noc-paused-what"></span></div>
          <div class="noc-admin glass" id="noc-admin" hidden>
            <b>Staff</b>
            <button type="button" class="noc-btn" id="adm-reset">Reset game…</button>
            <button type="button" class="noc-btn" id="adm-bsod">BSOD</button>
            <input id="adm-kick" placeholder="kick: ชื่อเล่น หรือ MAC" autocomplete="off" />
            <button type="button" class="noc-btn" id="adm-kick-btn">Kick</button>
            <button type="button" class="noc-btn" id="adm-pause-net" title="หยุด/เปิด SHTX-NET">Pause SHTX-NET</button>
            <button type="button" class="noc-btn" id="adm-pause-hunt" title="หยุด/เปิด Logo Hunting">Pause hunt</button>
            <button type="button" class="noc-btn" id="adm-submit" title="เปิด/ปิดรับโปรเจกต์">Close submissions</button>
            <button type="button" class="noc-btn" id="adm-vote" title="เปิด/ปิดโหวต Most Stupid Project">Open voting</button>
            <span class="adm-group" hidden title="ระบบ awards เดิม ถูกแทนด้วยหน้า /gacha">
              <select id="adm-p1" title="ที่ 1"><option value="">ที่ 1…</option></select>
              <select id="adm-p2" title="ที่ 2"><option value="">ที่ 2…</option></select>
              <select id="adm-p3" title="ที่ 3"><option value="">ที่ 3…</option></select>
              <button type="button" class="noc-btn" id="adm-places" title="ที่ 1-2-3 ได้ของ tier T1/T2/T3 ตายตัว">Award by tier</button>
              <button type="button" class="noc-btn" id="adm-gacha" title="ที่ 1-2-3 สุ่มคนละ 1 ชิ้นจากกอง T1+T2 (ที่ 1 หมุนก่อน) ของที่เหลือไปรอบโบนัส">🎰 Gacha 1-2-3</button>
              <button type="button" class="noc-btn" id="adm-draw" title="สุ่มของแจกกลางทางให้ทุกคน 1 ชิ้น ที่เหลือสุ่มรอบโบนัส">Lucky draw</button>
              <button type="button" class="noc-btn" id="adm-reveal" title="เปิดเผยรางวัลถัดไปบนจอ">Reveal next</button>
              <button type="button" class="noc-btn" id="adm-reveal-all" title="เปิดเผยทีละคนต่อเนื่องจนครบ (กดอีกครั้งเพื่อหยุด)">Reveal all</button>
              <input id="adm-claim" placeholder="จ่ายของแล้ว: ชื่อเล่น / ทีม / MAC" autocomplete="off" />
              <button type="button" class="noc-btn" id="adm-claim-btn">Claimed</button>
              <button type="button" class="noc-btn" id="adm-awards-reset" title="ล้างรางวัลทั้งหมด">Reset awards…</button>
            </span>
            <button type="button" class="noc-btn" id="adm-dead" title="สุ่ม 5 node ให้ตาย ต้อง air link ใหม่ใน 10 นาที">Dead Pixel round</button>
            <button type="button" class="noc-btn" id="adm-dead-end" title="จบรอบ Dead Pixel">End round</button>
            <button type="button" class="noc-btn" id="adm-bingo-reset" title="ล้างกระดาน Bingo">Reset bingo…</button>
            <button type="button" class="noc-btn" id="adm-vote-reset" title="ล้างคะแนนโหวต">Reset votes…</button>
            <input id="adm-vote-url" placeholder="Popular vote URL (ระบบ Uddy) ว่าง = ซ่อน" autocomplete="off" />
            <button type="button" class="noc-btn" id="adm-vote-url-set" title="ตั้ง/ล้างลิงก์โหวตสด ขึ้นในหน้าต่าง Stupid Vote ทุกเครื่องและ QR บนจอนี้">Set vote link</button>
            <input id="adm-update-msg" placeholder="Windows Update: ข้อความท้ายอัปเดต" autocomplete="off" />
            <button type="button" class="noc-btn" id="adm-update" title="ส่งหน้า Windows Update ไปทุกเครื่องที่เปิดเว็บอยู่">Push update</button>
            <button type="button" class="noc-btn" id="adm-hints" title="แก้คำใบ้ Logo Hunting">Hints…</button>
            <button type="button" class="noc-btn" id="adm-hunt-reset" title="ล้างผล Logo Hunting">Reset hunt…</button>
            <button type="button" class="noc-btn" id="adm-logout" title="ลืม token ในเครื่องนี้">Log out</button>
            <span id="adm-msg"></span>
          </div>
        </section>
        <aside class="noc-side">
          <div class="panel glass votelink" id="noc-votelink" hidden><h3>Popular vote · สแกนเพื่อโหวต</h3><canvas id="noc-vote-qr" width="180" height="180"></canvas><div class="votelink-url" id="noc-vote-url"></div></div>
          <div class="panel glass"><h3>Core switches</h3><ol id="noc-top"></ol></div>
          <div class="panel glass"><h3>Just connected</h3><ul id="noc-recent"></ul></div>
          <div class="panel glass"><h3>Pitching queue <span id="noc-proj-count"></span></h3><ol id="noc-projects"></ol></div>
          <div class="panel glass vote"><h3>Most Stupid Project <span id="noc-vote-state"></span></h3><ol id="noc-vote"></ol></div>
          <div class="panel glass bingo"><h3>Packet Loss Bingo <span id="noc-bingo-stats"></span></h3><ol id="noc-bingo"></ol></div>
          <div class="panel glass awards" id="noc-awards-panel" hidden><h3>Prizes <span id="noc-awards-stats"></span></h3><ol id="noc-awards"></ol></div>
          <div class="panel glass hunt"><h3>Drawdy Logo Hunting</h3><div class="hunt-keys" id="hunt-keys"></div><div class="hunt-done" id="hunt-done">ยังไม่มีใคร activate</div></div>
          <div class="panel glass idea"><h3>Dumb idea of the moment</h3><blockquote id="noc-idea">…</blockquote><cite id="noc-idea-by"></cite></div>
        </aside>
      </div>
      <footer class="noc-ticker glass"><div id="noc-ticker"><span>SHTX-NET NOC online · waiting for hosts…</span></div></footer>
    </div>
    <div class="noc-bsod" id="noc-bsod" hidden></div>
