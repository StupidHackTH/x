---
// Pretty address for the popular vote: stupid.hackathon.in.th/x/vote/ wraps Uddy's voting app (proxied on the NOC box)
// in a full-screen frame, so the QR and the link people see carry the event domain instead of an IP.
import { asset } from '../lib/asset';
const upstream = (import.meta.env.PUBLIC_VOTE_UPSTREAM as string | undefined) || 'https://82-26-104-114.sslip.io:8444/';
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>SHTX Popular Vote</title>
    <link rel="icon" href={asset('favicon-64.png')} />
    <style>
      html, body { margin: 0; height: 100%; background: #ece9d8; }
      iframe { position: fixed; inset: 0; width: 100%; height: 100%; border: 0; }
      .fb { position: fixed; left: 50%; bottom: max(10px, env(safe-area-inset-bottom)); transform: translateX(-50%); padding: 6px 12px; border-radius: 14px; background: rgba(10, 36, 106, 0.85); color: #fff; font: 12px Tahoma, sans-serif; text-decoration: none; opacity: 0; transition: opacity 0.4s; }
      .fb.show { opacity: 1; }
    </style>
  </head>
  <body>
    <iframe id="f" src={upstream} title="SHTX Popular Vote" allow="fullscreen" referrerpolicy="no-referrer"></iframe>
    <a class="fb" id="fb" href={upstream}>ถ้าหน้าโหวตไม่ขึ้น กดตรงนี้ ↗</a>
    <script>
      // show the escape hatch only if the frame has not loaded after a while (blocked, offline, …)
      let loaded = false;
      document.getElementById('f')!.addEventListener('load', () => (loaded = true));
      setTimeout(() => { if (!loaded) document.getElementById('fb')!.classList.add('show'); }, 6000);
    </script>
  </body>
</html>
